---
/**
 * Writing, page 2 and later. The slice is the same as page 1's, so pagination
 * never reshuffles a post between builds.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/Section.astro";
import Pager from "../../../components/writing/Pager.astro";
import PostList from "../../../components/writing/PostList.astro";
import site from "../../../data/site";
import {
  pageCount,
  pageSlice,
  publishedPosts,
} from "../../../lib/writing";

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection("writing"));
  const total = pageCount(posts.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const current = Number(Astro.params.page);
const posts = publishedPosts(await getCollection("writing"));
const visible = pageSlice(posts, current);
const total = pageCount(posts.length);
---

<BaseLayout
  title={`Writing — page ${current}`}
  description={site.description}
  path={`/writing/page/${current}`}
>
  <Section class="writing">
    <header class="writing__head">
      <h1 class="type-h1">Writing</h1>
    </header>

    <PostList entries={visible} />

    <Pager current={current} total={total} />
  </Section>
</BaseLayout>

<style>
  .writing {
    padding-block-end: var(--dab-space-16);
  }

  .writing__head {
    margin: 0;
    margin-block-end: var(--dab-space-8);
  }
</style>
