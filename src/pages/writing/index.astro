---
/**
 * Writing — the list page (DESIGN.md §6, §7.5).
 *
 * Page 1 lives here; later pages are `/writing/page/<n>`. A locale with no
 * posts says so instead of rendering an empty list.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import Pager from "../../components/writing/Pager.astro";
import PostList from "../../components/writing/PostList.astro";
import site from "../../data/site";
import {
  pageCount,
  pageSlice,
  publishedPosts,
} from "../../lib/writing";

const posts = publishedPosts(await getCollection("writing"));
const visible = pageSlice(posts, 1);
const total = pageCount(posts.length);
---

<BaseLayout title="Writing" description={site.description} path="/writing">
  <Section class="writing">
    <header class="writing__head">
      <h1 class="type-h1">Writing</h1>
    </header>

    {
      visible.length > 0 ? (
        <PostList entries={visible} />
      ) : (
        <p class="writing__empty type-body-lg">No posts yet.</p>
      )
    }

    <Pager current={1} total={total} />
  </Section>
</BaseLayout>

<style>
  .writing {
    padding-block-end: var(--dab-space-16);
  }

  .writing__head {
    margin: 0;
    margin-block-end: var(--dab-space-8);
  }

  .writing__empty {
    margin: 0;
    color: var(--dab-color-text-secondary);
  }
</style>
