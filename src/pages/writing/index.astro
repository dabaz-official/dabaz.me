---
/**
 * Writing — the list page for the default locale. Page 1 lives here; later
 * pages are `/writing/page/<n>`.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import WritingListPage from "../../components/writing/WritingListPage.astro";
import ui from "../../content/ui";
import { defaultLocale, otherLocale } from "../../lib/i18n";
import { collectionJsonLd } from "../../lib/structured-data";
import { writingPath } from "../../lib/writing";

const locale = defaultLocale;
const path = writingPath(locale);
const description = ui.writing.description[locale];
---

<BaseLayout
  title={ui.writing.title[locale]}
  description={description}
  path={path}
  locale={locale}
  alternatePath={writingPath(otherLocale(locale))}
  translationPath={writingPath(otherLocale(locale))}
  jsonLd={collectionJsonLd({
    locale,
    path,
    name: ui.writing.title[locale],
    description,
  })}
>
  <WritingListPage locale={locale} />
</BaseLayout>
