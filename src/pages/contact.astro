---
/**
 * Contact — the contact page for the default locale.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactPage from "../components/contact/ContactPage.astro";
import ui from "../content/ui";
import { contactPath, defaultLocale, otherLocale } from "../lib/i18n";

const locale = defaultLocale;
const path = contactPath(locale);
---

<BaseLayout
  title={ui.nav.contact[locale]}
  description={ui.contact.description[locale]}
  path={path}
  locale={locale}
  alternatePath={contactPath(otherLocale(locale))}
  translationPath={contactPath(otherLocale(locale))}
  surface="secondary"
>
  <ContactPage locale={locale} />
</BaseLayout>
