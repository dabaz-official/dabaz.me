---
/**
 * Writing, page 2 and later for Chinese (`/zh/writing/page/<n>`).
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WritingListPage from "../../../../components/writing/WritingListPage.astro";
import ui from "../../../../content/ui";
import { otherLocale, type Locale } from "../../../../lib/i18n";
import { collectionJsonLd } from "../../../../lib/structured-data";
import {
  pageCount,
  pagePath,
  postsForLocale,
  publishedPosts,
  writingPath,
} from "../../../../lib/writing";

const locale: Locale = "zh";

export async function getStaticPaths() {
  const posts = postsForLocale(
    publishedPosts(await getCollection("writing")),
    "zh",
  );
  const total = pageCount(posts.length);
  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const current = Number(Astro.params.page);
const path = pagePath(current, locale);
const description = ui.writing.pageDescription[locale](current);

// The translated page exists only when the other locale also has this page.
const all = publishedPosts(await getCollection("writing"));
const otherTotal = pageCount(postsForLocale(all, otherLocale(locale)).length);
const translationPath =
  current <= otherTotal ? pagePath(current, otherLocale(locale)) : undefined;
---

<BaseLayout
  title={ui.writing.pageTitle[locale](current)}
  description={description}
  path={path}
  locale={locale}
  alternatePath={writingPath(otherLocale(locale))}
  translationPath={translationPath}
  jsonLd={collectionJsonLd({
    locale,
    path,
    name: ui.writing.pageTitle[locale](current),
    description,
  })}
>
  <WritingListPage locale={locale} page={current} />
</BaseLayout>
