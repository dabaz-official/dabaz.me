---
/**
 * Every Chinese post that carries one tag (`/zh/writing/tag/<tag>`).
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import WritingTagPage from "../../../../components/writing/WritingTagPage.astro";
import ui from "../../../../content/ui";
import type { Locale } from "../../../../lib/i18n";
import {
  alternateTagPath,
  collectTags,
  tagPathFromSlug,
  postsForLocale,
  publishedPosts,
  type WritingEntry,
} from "../../../../lib/writing";

const locale: Locale = "zh";

interface Props {
  label: string;
  slug: string;
  entries: WritingEntry[];
  all: WritingEntry[];
}

export async function getStaticPaths() {
  const all = publishedPosts(await getCollection("writing"));
  return collectTags(postsForLocale(all, "zh")).map((tag) => ({
    params: { tag: tag.slug },
    props: { label: tag.label, slug: tag.slug, entries: tag.posts, all },
  }));
}

const { label, slug, entries, all } = Astro.props;
---

<BaseLayout
  title={ui.writing.tagTitle[locale](label)}
  description={ui.writing.tagDescription[locale](label)}
  path={tagPathFromSlug(slug, locale)}
  locale={locale}
  alternatePath={alternateTagPath(slug, locale, all)}
>
  <WritingTagPage label={label} locale={locale} entries={entries} />
</BaseLayout>
