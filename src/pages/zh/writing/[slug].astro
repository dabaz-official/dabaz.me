---
/**
 * One Chinese post. The slug is shared across locales; the `/zh` prefix keeps
 * the two routes apart.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostArticle from "../../../components/writing/PostArticle.astro";
import type { Locale } from "../../../lib/i18n";
import { postJsonLd } from "../../../lib/structured-data";
import {
  alternatePostPath,
  postPath,
  postSlug,
  postsForLocale,
  publishedPosts,
  translationPostPath,
} from "../../../lib/writing";

const locale: Locale = "zh";

export async function getStaticPaths() {
  const all = publishedPosts(await getCollection("writing"));
  return postsForLocale(all, "zh").map((entry) => ({
    params: { slug: postSlug(entry) },
    props: { entry, all },
  }));
}

const { entry, all } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  path={postPath(entry)}
  locale={entry.data.locale}
  alternatePath={alternatePostPath(entry, all)}
  translationPath={translationPostPath(entry, all)}
  ogType="article"
  jsonLd={postJsonLd(entry)}
>
  <PostArticle entry={entry} />
</BaseLayout>
