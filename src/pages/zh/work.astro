---
/**
 * Work — the Chinese page (`/zh/work`).
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkPage from "../../components/work/WorkPage.astro";
import ui from "../../content/ui";
import { otherLocale, workPath, type Locale } from "../../lib/i18n";
import { sortWorks } from "../../lib/works";

const locale: Locale = "zh";
const path = workPath(locale);
const description = ui.work.description[locale];

// The curated order lives in `src/lib/works.ts` (§10): `order`, then year.
const works = sortWorks(await getCollection("works"));
---

<BaseLayout
  title={ui.nav.work[locale]}
  description={description}
  path={path}
  locale={locale}
  alternatePath={workPath(otherLocale(locale))}
  translationPath={workPath(otherLocale(locale))}
  surface="secondary"
>
  <WorkPage entries={works} locale={locale} />
</BaseLayout>
