---
/**
 * Contact — the music marks.
 *
 * Every place the catalogue lives, under the same width as the profile row:
 * Spotify, Apple Music, YouTube, Bandcamp, and SoundCloud from `platforms`,
 * then DabMusic, the own player, drawn with the DabAZ mark.
 *
 * Each anchor is the 24px glyph with its name as `aria-label`; the 44px target
 * rides on a pseudo-element, the treatment the rest of the page uses.
 */
import { ownPlayer, platforms } from "../../data/music";
import ui from "../../content/ui";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

interface Icon {
  viewBox: string;
  d: string;
  /** The DabAZ mark needs even-odd winding; the simple-icons paths do not. */
  evenodd?: boolean;
}

