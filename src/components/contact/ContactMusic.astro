const { locale } = Astro.props;

const links = [
  ...platforms.map(({ label, href }) => ({ label, href })),
  { label: ownPlayer.label, href: ownPlayer.href },
].filter(({ label }) => Boolean(icons[label]));
---

<div class="contact-music">
  <h2 class="type-label-caps contact-music__label">
    {ui.nav.music[locale]}
  </h2>
  <ul class="contact-music__list">
    {
      links.map(({ label, href }) => (
        <li>
          <a
            class="contact-music__link"
            href={href}
            target="_blank"
            rel="noreferrer"
            aria-label={label}
            lang="en"
          >
            <svg
              class="contact-music__mark"
              viewBox={icons[label].viewBox}
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d={icons[label].d}
                fill="currentColor"
                fill-rule={icons[label].evenodd ? "evenodd" : undefined}
                clip-rule={icons[label].evenodd ? "evenodd" : undefined}
              />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact-music__label {
    margin: 0 0 var(--dab-space-2);
    color: var(--dab-color-text-tertiary);
  }

  .contact-music__list {
    display: flex;
    flex-wrap: wrap;
    /* The marks keep their 20px gap and align to the column's start; they do
       not stretch to fill a full-width button row on a phone. */
    justify-content: flex-start;
    gap: var(--dab-space-5);
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-music__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--dab-size-icon-lg);
    block-size: var(--dab-size-icon-lg);
    color: var(--dab-color-text-secondary);
    transition: color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .contact-music__link::after {
    content: "";
    position: absolute;
    inset: calc((var(--dab-size-icon-lg) - var(--dab-target-min)) / 2);
  }

  .contact-music__link:hover {
    color: var(--dab-color-text-primary);
  }

  .contact-music__mark {
    display: block;
    inline-size: var(--dab-size-icon-lg);
    block-size: var(--dab-size-icon-lg);
  }
</style>
