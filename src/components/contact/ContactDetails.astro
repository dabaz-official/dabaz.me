---
/**
 * Contact — the link buttons.
 *
 * Two pills only: the address, which is what the page is for, and the CV. They
 * are the site's `PillButton`, filled to the width the page gives the group, so
 * the fill, the height, and the hover are the same ones `View All` and
 * `Read more` use. The CV is the one profile whose word translates, so it reads
 * 简历 on a zh page.
 */
import PillButton from "../PillButton.astro";
import site from "../../data/site";
import social, { socialLabel } from "../../data/social";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

interface Link {
  label: string;
  href: string;
  /** The label's own language, when it is not the page's. */
  lang?: string;
  /** A destination outside the site, so it opens in a new tab. */
  external?: boolean;
}

const { locale } = Astro.props;

const cv = social.all.find((link) => link.label === "CV");
const cvText = cv ? socialLabel(cv, locale) : undefined;

const links: Link[] = [
  { label: site.email, href: `mailto:${site.email}` },
  ...(cv && cvText
    ? [
        {
          label: cvText.label,
          href: cv.href,
          lang: cvText.lang,
          external: true,
        },
      ]
    : []),
];
---

<ul class="contact-links">
  {
    links.map(({ label, href, lang, external }) => (
      <li>
        <PillButton
          fill
          href={href}
          label={label}
          lang={lang}
          external={external}
        />
      </li>
    ))
  }
</ul>

<style>
  .contact-links {
    display: grid;
    gap: var(--dab-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
