---
/**
 * Contact: one address, then the profiles.
 *
 * The profiles are the subset of `social.all` that belongs on a contact card;
 * YouTube and Spotify live in the music section instead.
 *
 * The home band and `/contact` share this body; each wrapper owns its heading.
 */
import site from "../../data/site";
import social, { contactLabels as labels, type Social } from "../../data/social";

const links = labels
  .map((label) => social.all.find((socialLink) => socialLink.label === label))
  .filter((socialLink): socialLink is Social => Boolean(socialLink));
---

<a class="type-h3 contact__email" href={`mailto:${site.email}`}>{site.email}</a>
<ul class="contact__links">
  {
    links.map(({ label, href }) => (
      <li>
        <a class="type-h3" href={href} target="_blank" rel="noreferrer" lang="en"
          >{label}</a
        >
      </li>
    ))
  }
</ul>

<style>
  .contact__email {
    display: inline-block;
    color: var(--dab-color-text-primary);
    text-decoration: none;
  }

  .contact__email:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact__links {
    inline-size: fit-content;
    display: flex;
    flex-wrap: wrap;
    gap: var(--dab-space-2) var(--dab-space-6);
    margin: var(--dab-space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .contact__links a {
    color: var(--dab-color-text-secondary);
    text-decoration: none;
  }

  .contact__links a:hover {
    color: var(--dab-color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
