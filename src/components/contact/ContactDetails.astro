---
/**
 * Contact — the link buttons.
 *
 * Two pills only: the address, which is what the page is for, and the CV. They
 * use the site's pill button, so the fill, the height, and the hover are the
 * same ones `View All` and `Read more` use. The CV is the one profile whose
 * word translates, so it reads 简历 on a zh page.
 */
import site from "../../data/site";
import social, { socialLabel } from "../../data/social";
import type { Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

interface Link {
  label: string;
  href: string;
  /** The label's own language, when it is not the page's. */
  lang?: string;
  /** A destination outside the site, so it opens in a new tab. */
  external?: boolean;
}

const { locale } = Astro.props;

const cv = social.all.find((link) => link.label === "CV");
const cvText = cv ? socialLabel(cv, locale) : undefined;

const links: Link[] = [
  { label: site.email, href: `mailto:${site.email}` },
  ...(cv && cvText
    ? [
        {
          label: cvText.label,
          href: cv.href,
          lang: cvText.lang,
          external: true,
        },
      ]
    : []),
];
---

<ul class="contact-links">
  {
    links.map(({ label, href, lang, external }) => (
      <li>
        <a
          class="button type-body contact-links__button"
          href={href}
          lang={lang}
          target={external ? "_blank" : undefined}
          rel={external ? "noreferrer" : undefined}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact-links {
    display: grid;
    gap: var(--dab-space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The caller sets the group's width; each pill fills it. */
  .contact-links__button {
    inline-size: 100%;
    min-height: var(--dab-control-height-lg);
    padding-inline: var(--dab-space-6);
    border-radius: var(--dab-radius-pill);
    box-shadow: none;
    transition:
      background-color var(--dab-duration-fast) var(--dab-easing-linear),
      box-shadow var(--dab-duration-base) var(--dab-easing-standard),
      translate var(--dab-duration-base) var(--dab-easing-standard);
  }

  /* The same lift the site's other pill has, so the two read as one control
     family. */
  .contact-links__button:hover {
    box-shadow: var(--dab-shadow-floating);
    translate: 0 -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-links__button {
      transition: background-color var(--dab-duration-fast) var(--dab-easing-linear);
    }

    .contact-links__button:hover {
      translate: none;
    }
  }
</style>
