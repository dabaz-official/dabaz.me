---
/**
 * Writing — the home band: the newest three posts as cards, after Apple's
 * newsroom. The cards themselves live in `components/writing/PostCards.astro`,
 * which the list and tag pages also use; this band owns the head, the band
 * tone, and the decision to render at all.
 *
 * The page decides whether the section exists: a locale with no published
 * posts renders no Writing section, never an empty heading. `View All` appears
 * only when more posts exist than the shelf shows.
 */
import Container from "../Container.astro";
import PostCards from "../writing/PostCards.astro";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";
import { writingPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entries: WritingEntry[];
  hasMore: boolean;
  locale?: Locale;
}

const { entries, hasMore, locale = defaultLocale } = Astro.props;
---

<section class="writing" id="writing" aria-labelledby="writing-title">
  <Container>
    <div class="writing__head">
      <h2 class="writing__title type-h1" id="writing-title">
        {ui.nav.writing[locale]}
      </h2>

      {
        hasMore && (
          <a
            class="button writing__all type-body"
            href={writingPath(locale)}
          >
            {ui.writing.viewAll[locale]}
          </a>
        )
      }
    </div>

    <PostCards
      entries={entries}
      locale={locale}
      columns="three"
      headingLevel="h3"
    />

  </Container>
</section>

<style>
  .writing {
    --dab-section-fill: var(--dab-color-surface-secondary);
    padding-block: var(--dab-space-16);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  /* One row: the title on the left, the pill at the far edge. */
  .writing__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--dab-space-4);
    margin-block-end: var(--dab-space-6);
  }

  .writing__title {
    inline-size: fit-content;
    margin: 0;
    color: var(--dab-color-text-primary);
  }

  .writing__all {
    flex: none;
    border: 0;
    border-radius: var(--dab-radius-pill);
    padding-inline: var(--dab-space-6);
    transition:
      background-color var(--dab-duration-fast) var(--dab-easing-linear),
      box-shadow var(--dab-duration-base) var(--dab-easing-standard),
      translate var(--dab-duration-base) var(--dab-easing-standard);
  }

  /* The pill lifts a pixel and takes the one shadow: the primitive's own
     fill change is too quiet to read as feedback. */
  .writing__all:hover {
    box-shadow: var(--dab-shadow-floating);
    translate: 0 -1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .writing__all {
      transition: background-color var(--dab-duration-fast) var(--dab-easing-linear);
    }

    .writing__all:hover {
      translate: none;
    }
  }
</style>
