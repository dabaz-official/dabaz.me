---
/**
 * Writing: the newest three posts, in the same row grammar as `/writing`
 * (DESIGN.md §6, §7.5).
 *
 * The page decides whether the section exists at all: a locale with no
 * published posts renders no Writing section, never an empty heading. The
 * `All writing` link appears only when there are more posts than the list
 * shows. Tags stay on the post page so the home rows stay scannable.
 */
import Container from "../Container.astro";
import PostList from "../writing/PostList.astro";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";
import { writingPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entries: WritingEntry[];
  hasMore: boolean;
  locale?: Locale;
}

const { entries, hasMore, locale = defaultLocale } = Astro.props;
---

<section class="writing" id="writing" aria-labelledby="writing-title">
  <Container>
    <h2 class="writing__title type-display" id="writing-title">
      {ui.nav.writing[locale]}
    </h2>

    <PostList entries={entries} headingLevel="h3" showTags={false} />

    {
      hasMore && (
        <p class="writing__more">
          <a class="link type-label" href={writingPath(locale)}>
            {ui.writing.all[locale]}
          </a>
        </p>
      )
    }
  </Container>
</section>

<style>
  .writing {
    padding-block-start: var(--dab-space-24);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  .writing__title {
    inline-size: fit-content;
    margin: 0;
    margin-block-end: var(--dab-space-10);
    color: var(--dab-color-text-primary);
  }

  .writing__more {
    margin: 0;
    margin-block-start: var(--dab-space-8);
  }
</style>
