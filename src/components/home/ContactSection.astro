---
/**
 * Contact: the home band.
 *
 * `ContactDetails` holds the address and the profiles; `/contact` renders the
 * same body under its own `h1`.
 */
import Container from "../Container.astro";
import ContactDetails from "../contact/ContactDetails.astro";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <Container>
    <h2 class="contact__title type-display" id="contact-title">
      {ui.nav.contact[locale]}
    </h2>
    <ContactDetails />
  </Container>
</section>

<style>
  .contact {
    padding-block: var(--dab-space-24);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  .contact__title {
    inline-size: fit-content;
    margin: 0;
    margin-block-end: var(--dab-space-10);
    color: var(--dab-color-text-primary);
  }
</style>
