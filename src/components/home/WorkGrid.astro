---
/**
 * Work: the two-up grid of shipped things.
 *
 * The home band; `/work` renders the same grid under its own `h1`.
 */
import type { CollectionEntry } from "astro:content";
import Container from "../Container.astro";
import WorkGallery from "../work/WorkGallery.astro";
import ui from "../../content/ui";
import type { Locale } from "../../lib/i18n";

interface Props {
  entries: CollectionEntry<"works">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<section class="work" id="work" aria-labelledby="work-title">
  <Container>
    <h2 class="work__title type-display" id="work-title">{ui.nav.work[locale]}</h2>

    <WorkGallery entries={entries} locale={locale} />
  </Container>
</section>

<style>
  .work {
    padding-block-start: var(--dab-space-24);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  .work__title {
    inline-size: fit-content;
    margin: 0;
    margin-block-end: var(--dab-space-10);
    color: var(--dab-color-text-primary);
  }
</style>
