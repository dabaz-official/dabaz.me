---
/**
 * Music: the streaming index, the player I built, and the latest releases.
 *
 * The home band; `/music` renders the same body under its own `h1`.
 */
import Container from "../Container.astro";
import MusicContent from "../music/MusicContent.astro";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section class="music" id="music" aria-labelledby="music-title">
  <Container>
    <h2 class="music__title type-h1" id="music-title">{ui.nav.music[locale]}</h2>

    <MusicContent locale={locale} />
  </Container>
</section>

<style>
  .music {
    --dab-section-fill: var(--dab-color-surface-secondary);
    padding-block: var(--dab-space-16);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  .music__title {
    inline-size: fit-content;
    margin: 0;
    margin-block-end: var(--dab-space-10);
    color: var(--dab-color-text-primary);
  }
</style>
