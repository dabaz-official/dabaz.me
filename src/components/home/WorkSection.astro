---
/**
 * Work: the home band around the project showcase.
 *
 * `/work` keeps the two-up grid (`components/work/WorkPage.astro`); the home
 * band is the pill-tab showcase, one screenshot and one summary per project.
 */
import type { CollectionEntry } from "astro:content";
import Container from "../Container.astro";
import WorkShowcase from "../work/WorkShowcase.astro";
import home from "../../content/profile";
import ui from "../../content/ui";
import type { Locale } from "../../lib/i18n";

interface Props {
  entries: CollectionEntry<"works">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<section class="work" id="work" aria-labelledby="work-title">
  <Container>
    <h2 class="work__title type-h1" id="work-title">{ui.nav.work[locale]}</h2>

    <WorkShowcase entries={entries} locale={locale} />
  </Container>
</section>

<style>
  .work {
    padding-block: var(--dab-space-16);
    scroll-margin-block-start: calc(var(--dab-header-height) + var(--dab-space-4));
  }

  .work__title {
    inline-size: fit-content;
    margin: 0;
    margin-block-end: var(--dab-space-10);
    color: var(--dab-color-text-primary);
  }

</style>
