---
/**
 * The home page's records, in DESIGN.md §6 order.
 *
 * One composition for both locales: the shell owns the title and description,
 * this component owns the sections. Sections after the hero stay direct children
 * of `<main>`, so the scroll-over in `global.css` still applies.
 *
 * A locale's Writing band appears only when that locale has a published post;
 * the other language's posts are never borrowed (DESIGN.md §6, §10).
 */
import { getCollection } from "astro:content";
import HeroStage from "./HeroStage.astro";
import Intro from "./Intro.astro";
import WorkGrid from "./WorkGrid.astro";
import MusicSection from "./MusicSection.astro";
import WritingSection from "./WritingSection.astro";
import ContactSection from "./ContactSection.astro";
import type { Locale } from "../../lib/i18n";
import { postsForLocale, publishedPosts } from "../../lib/writing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Newest first; `year` drives the order (§10).
const works = (await getCollection("works")).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0),
);

// Newest first; the home list shows the first three and links out for the rest.
const posts = postsForLocale(
  publishedPosts(await getCollection("writing")),
  locale,
);
---

<HeroStage locale={locale} />
<Intro locale={locale} />
<WorkGrid entries={works} locale={locale} />
<MusicSection locale={locale} />
{
  posts.length > 0 && (
    <WritingSection
      locale={locale}
      entries={posts.slice(0, 3)}
      hasMore={posts.length > 3}
    />
  )
}
<ContactSection locale={locale} />
