---
/**
 * Earlier roles — DESIGN.md §6 ("Earlier", only when data exists).
 *
 * Same row grammar as the work list (§7.4): 9rem meta column, hairline rows,
 * stacked below 640. The meta is the year range; the title is the role and the
 * organisation sits under it as the proper noun.
 */
import type { CollectionEntry } from "astro:content";
import type { Locale } from "../../lib/i18n";

interface Props {
  entries: CollectionEntry<"experience">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
---

<ul class="experience-list">
  {
    entries.map((entry) => {
      const { org, role, start, end, summary, href } = entry.data;
      const meta = `${start} — ${end === "now" ? "now" : end}`;
      const Tag = href ? "a" : "div";
      return (
        <li class="experience-row">
          <Tag class="experience-row__row" href={href}>
            <span class="type-caption tabular experience-row__meta">{meta}</span>
            <div class="experience-row__body">
              <h3 class="type-h3 experience-row__title">{role[locale]}</h3>
              <p class="type-label experience-row__org">{org}</p>
              {summary && (
                <p class="type-body-sm experience-row__summary">
                  {summary[locale]}
                </p>
              )}
            </div>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .experience-list {
    margin-block-start: var(--dab-space-8);
    padding: 0;
    list-style: none;
  }

  .experience-row {
    border-block-start: var(--dab-border-width) solid var(--dab-color-border);
  }

  .experience-row:last-child {
    border-block-end: var(--dab-border-width) solid var(--dab-color-border);
  }

  .experience-row__row {
    display: grid;
    gap: var(--dab-space-2);
    padding-block: var(--dab-space-6);
    color: inherit;
    text-decoration: none;
  }

  .experience-row__meta {
    color: var(--dab-color-text-tertiary);
  }

  .experience-row__body {
    display: flex;
    flex-direction: column;
    gap: var(--dab-space-1);
    min-inline-size: 0;
  }

  .experience-row__title {
    color: var(--dab-color-text-primary);
  }

  .experience-row__org {
    color: var(--dab-color-text-secondary);
  }

  .experience-row__summary {
    max-width: var(--dab-measure);
    color: var(--dab-color-text-secondary);
  }

  .experience-row__row:hover .experience-row__title,
  .experience-row__row:focus-visible .experience-row__title {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* 9rem meta column from 640, per DESIGN.md §7.4. */
  @media (min-width: 640px) {
    .experience-row__row {
      grid-template-columns: 9rem minmax(0, 1fr);
      column-gap: var(--dab-space-6);
      align-items: start;
    }

    .experience-row__meta {
      padding-block-start: var(--dab-space-1);
    }
  }
</style>
