---
/**
 * Blog: nothing published yet, so it says so and offers the feed.
 *
 * When the first post lands, this block becomes the dated rows the direction
 * spec describes; the heading and the feed link stay.
 */
import Container from "../Container.astro";
---

<section class="blog" id="blog" aria-labelledby="blog-title">
  <Container>
    <h2 class="blog__title type-h2" id="blog-title">Blog</h2>
    <p class="blog__soon type-body-lg">
      Coming soon… <a class="blog__rss" href="/rss.xml">RSS</a>
    </p>
  </Container>
</section>

<style>
  .blog {
    padding-block-start: var(--dab-space-24);
    scroll-margin-block-start: calc(var(--dab-space-16) + var(--dab-space-4));
  }

  .blog__title {
    margin: 0;
    margin-block-end: var(--dab-space-8);
    color: var(--dab-color-text-primary);
  }

  .blog__soon {
    margin: 0;
    color: var(--dab-color-text-secondary);
  }

  .blog__rss {
    color: inherit;
    text-decoration: none;
  }

  .blog__rss:hover {
    color: var(--dab-color-text-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
