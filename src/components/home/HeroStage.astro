---
/**
 * Hero: the cutout portrait over the oversized name, with the scroll cue.
 *
 * One viewport tall and in flow: the hero scrolls away with the page. It used
 * to pin so the sections scrolled over it, which read as a parallax drag.
 *
 * Art direction is a `<picture>`: the tall crop on phones, the 4K master on
 * wide screens, the 2880 otherwise. Each file is already sized for its slot,
 * so the browser never scales a bitmap up.
 */
import home from "../../content/profile";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";
import hero780 from "../../assets/hero/hero-780.webp";
import hero2880 from "../../assets/hero/hero-2880.webp";
import hero3840 from "../../assets/hero/hero-3840.webp";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section class="stage" aria-label={ui.home.portrait[locale]}>
  <div class="backdrop" aria-hidden="true">
    <svg
      class="word"
      viewBox="0 0 144 36"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M11.8295 34.9091H0V0H12.0681C15.5341 0 18.5113 0.698864 21 2.09659C23.5 3.48295 25.4204 5.47727 26.7613 8.07954C28.1022 10.6818 28.7727 13.7954 28.7727 17.4204C28.7727 21.0568 28.0966 24.1818 26.7443 26.7954C25.4034 29.4091 23.4659 31.4148 20.9318 32.8125C18.4091 34.2102 15.375 34.9091 11.8295 34.9091ZM6.32386 29.4375H11.5227C13.9545 29.4375 15.9829 28.9943 17.6079 28.1079C19.2329 27.2102 20.4545 25.875 21.2727 24.1023C22.0909 22.3182 22.5 20.0909 22.5 17.4204C22.5 14.75 22.0909 12.5341 21.2727 10.7727C20.4545 9 19.2443 7.67614 17.642 6.80114C16.0511 5.91477 14.0738 5.47159 11.7102 5.47159H6.32386V29.4375ZM40.1226 35.4375C38.4635 35.4375 36.9692 35.142 35.6396 34.5511C34.3214 33.9489 33.276 33.0625 32.5033 31.892C31.7419 30.7216 31.3612 29.2784 31.3612 27.5625C31.3612 26.0852 31.6339 24.8636 32.1794 23.8977C32.7249 22.9318 33.4692 22.1591 34.4124 21.5795C35.3555 21 36.418 20.5625 37.5999 20.267C38.793 19.9602 40.026 19.7386 41.2987 19.6023C42.8328 19.4432 44.0771 19.3011 45.0317 19.1761C45.9862 19.0398 46.6794 18.8352 47.1112 18.5625C47.5544 18.2784 47.776 17.8409 47.776 17.25V17.1477C47.776 15.8636 47.3953 14.8693 46.6339 14.1648C45.8726 13.4602 44.776 13.1079 43.3442 13.1079C41.8328 13.1079 40.6339 13.4375 39.7476 14.0966C38.8726 14.7557 38.2817 15.5341 37.9749 16.4318L32.2135 15.6136C32.668 14.0227 33.418 12.6932 34.4635 11.625C35.5089 10.5454 36.7874 9.73863 38.2987 9.20454C39.8101 8.65909 41.4805 8.38636 43.3101 8.38636C44.5714 8.38636 45.8271 8.53409 47.0771 8.82954C48.3271 9.125 49.4692 9.61363 50.5033 10.2954C51.5374 10.9659 52.3669 11.8807 52.9919 13.0398C53.6283 14.1989 53.9464 15.6477 53.9464 17.3864V34.9091H48.0146V31.3125H47.8101C47.4351 32.0398 46.9067 32.7216 46.2249 33.3579C45.5544 33.9829 44.7078 34.4886 43.6851 34.875C42.6737 35.25 41.4862 35.4375 40.1226 35.4375ZM41.7249 30.9034C42.9635 30.9034 44.0374 30.6591 44.9464 30.1704C45.8555 29.6704 46.5544 29.0114 47.043 28.1932C47.543 27.375 47.793 26.4829 47.793 25.517V22.4318C47.5999 22.590