---
/**
 * Hero: the cutout portrait over the oversized name, with the scroll cue.
 *
 * One viewport tall and in flow: the hero scrolls away with the page. It used
 * to pin so the sections scrolled over it, which read as a parallax drag.
 *
 * Art direction is a `<picture>`: the tall crop on phones, the 4K master on
 * wide screens, the 2880 otherwise. Each file is already sized for its slot,
 * so the browser never scales a bitmap up.
 */
import home from "../../content/profile";
import ui from "../../content/ui";
import { defaultLocale, type Locale } from "../../lib/i18n";
import hero780 from "../../assets/hero/hero-780.webp";
import hero2880 from "../../assets/hero/hero-2880.webp";
import hero3840 from "../../assets/hero/hero-3840.webp";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section class="stage" aria-label={ui.home.portrait[locale]}>
  <div class="backdrop" aria-hidden="true">
    <svg
      class="word"
      viewBox="0 0 512 128"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M42.3 126.091H0V0H43.1534C55.5467 0 66.1928 2.52428 75.0915 7.57288C84.0311 12.5804 90.8982 19.7839 95.6931 29.1833C100.488 38.5827 102.885 49.8291 102.885 62.9226C102.885 76.0571 100.468 87.3446 95.632 96.7851C90.8373 106.226 83.9092 113.47 74.8478 118.519C65.827 123.567 54.9777 126.091 42.3 126.091ZM22.6128 106.328H41.2028C49.8986 106.328 57.1516 104.727 62.9624 101.526C68.773 98.2831 73.1412 93.4603 76.0668 87.0572C78.9924 80.6132 80.4552 72.5683 80.4552 62.9226C80.4552 53.2768 78.9924 45.273 76.0668 38.911C73.1412 32.5079 68.8136 27.7261 63.0843 24.5657C57.3955 21.3641 50.3251 19.7633 41.8733 19.7633H22.6128V106.328ZM143.471 128C137.537 128 132.194 126.933 127.44 124.799C122.726 122.623 118.988 119.422 116.225 115.194C113.502 110.966 112.141 105.753 112.141 99.5555C112.141 94.2196 113.116 89.8072 115.067 86.3185C117.017 82.8295 119.679 80.0385 123.051 77.9452C126.424 75.8518 130.223 74.2716 134.449 73.2045C138.716 72.0962 143.125 71.2959 147.676 70.8032C153.161 70.2286 157.611 69.7156 161.023 69.2641C164.437 68.7715 166.915 68.0327 168.46 67.0476C170.045 66.0214 170.837 64.4413 170.837 62.3069V61.9375C170.837 57.2993 169.476 53.7078 166.753 51.163C164.031 48.6183 160.11 47.3459 154.989 47.3459C149.585 47.3459 145.298 48.5361 142.13 50.9168C139 53.2974 136.887 56.109 135.79 59.3516L115.189 56.3964C116.814 50.6499 119.496 45.8477 123.234 41.9894C126.973 38.0901 131.544 35.1759 136.948 33.2468C142.352 31.2766 148.326 30.2914 154.868 30.2914C159.378 30.2914 163.869 30.8251 168.338 31.8923C172.807 32.9594 176.892 34.7244 180.589 37.1872C184.287 39.6087 187.253 42.9129 189.488 47.0995C191.764 51.2861 192.901 56.5195 192.901 62.7994V126.091H171.69V113.101H170.96C169.619 115.727 167.728 118.19 165.29 120.489C162.893 122.746 159.866 124.573 156.209 125.968C152.593 127.323 148.346 128 143.471 128ZM149.199 111.623C153.628 111.623 157.468 110.74 160.719 108.976C163.969 107.169 166.469 104.789 168.216 101.834C170.003 98.8783 170.898 95.6562 170.898 92.1674V81.0236C170.207 81.5982 169.029 82.1318 167.363 82.6243C165.738 83.1168 163.909 83.5478 161.877 83.9173C159.846 84.2867 157.835 84.615 155.843 84.9023C153.852 85.1898 152.125 85.436 150.662 85.6412C147.371 86.0927 144.425 86.8315 141.824 87.8576C139.224 88.8837 137.172 90.3203 135.668 92.1674C134.165 93.9734 133.413 96.313 133.413 99.1862C133.413 103.291 134.897 106.39 137.863 108.483C140.829 110.576 144.608 111.623 149.199 111.623ZM209.197 126.091V0H231.261V47.1612H232.175C233.314 44.8626 234.919 42.4204 236.99 39.8345C239.064 37.2076 241.867 34.9707 245.402 33.1237C248.937 31.2355 253.448 30.2914 258.933 30.2914C266.166 30.2914 272.687 32.159 278.499 35.8942C284.349 39.5883 288.982 45.0678 292.395 52.3329C295.849 59.5568 297.576 68.4227 297.576 78.9302C297.576 89.3147 295.889 98.1396 292.517 105.405C289.144 112.67 284.553 118.211 278.743 122.028C272.931 125.845 266.349 127.754 258.994 127.754C253.63 127.754 249.181 126.851 245.646 125.045C242.11 123.239 239.266 121.063 237.112 118.519C234.999 115.933 233.354 113.49 232.175 111.192H230.896V126.091H209.197ZM230.834 78.8071C230.834 84.9229 231.688 90.2793 233.394 94.8764C235.141 99.4735 237.641 103.065 240.891 105.651C244.183 108.196 248.166 109.468 252.837 109.468C257.714 109.468 261.798 108.155 265.089 105.528C268.38 102.86 270.859 99.2272 272.525 94.6301C274.232 89.992 275.085 84.7177 275.085 78.8071C275.085 72.9376 274.252 67.7249 272.587 63.1689C270.92 58.6127 268.442 55.0419 265.15 52.456C261.859 49.8701 257.755 48.5771 252.837 48.5771C248.124 48.5771 244.121 49.8291 240.831 52.3329C237.539 54.8367 235.041 58.3461 233.334 62.861C231.668 67.3759 230.834 72.6914 230.834 78.8071ZM320.606 126.091H296.47L340.416 0H368.331L412.339 126.091H388.202L354.861 25.8586H353.887L320.606 126.091ZM321.399 76.6522H387.226V94.9996H321.399V76.6522ZM419.598 126.091V111.869L483.597 19.1477H419.232V0H511.634V14.2222L447.696 106.944H512V126.091H419.598Z" fill="currentColor" />
    </svg>
  </div>

  <picture class="media">
    <source media="(max-width: 640px)" srcset={hero780.src} />
    <source media="(min-width: 1600px)" srcset={hero3840.src} />
    <img
      class="figure"
      src={hero2880.src}
      alt={home.portrait.alt[locale]}
      width="2880"
      height="1680"
      fetchpriority="high"
    />
  </picture>

  <div class="cue" aria-hidden="true">
    <span class="cue__label type-caption">{ui.home.scrollDown[locale]}</span>
    <svg
      class="cue__mouse"
      width="24"
      height="36"
      viewBox="0 0 24 36"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
    >
      <rect x="1" y="1" width="22" height="34" rx="11"></rect>
      <circle class="cue__wheel" cx="12" cy="10" r="1.6" fill="currentColor" stroke="none"></circle>
    </svg>
  </div>
</section>

<style>
  .stage {
    position: relative;
    background-color: var(--dab-color-surface-secondary);
    block-size: calc(100dvh - var(--dab-header-height));
    overflow: clip;
  }

  .backdrop {
    position: absolute;
    inset-block-start: 27%;
    inset-inline: 0;
    z-index: 0;
    inline-size: calc(min(100%, var(--dab-container-lg)) - 2 * var(--dab-gutter));
    margin-inline: auto;
    container-type: inline-size;
    text-align: center;
    pointer-events: none;
    user-select: none;
  }

  .word {
    display: block;
    inline-size: 100%;
    block-size: auto;
    /* Flat white: the mark sits a hair above the band's tone, so it reads as a
       watermark rather than as type. */
    color: var(--dab-color-surface);
  }

  .media {
    position: relative;
    z-index: 1;
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .figure {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .cue {
    position: absolute;
    inset-block-end: var(--dab-space-6);
    /* above the portrait: the media sits at z-index 1 */
    z-index: 2;
    inset-inline: 0;
    display: grid;
    justify-items: center;
    gap: var(--dab-space-2);
    color: var(--dab-color-text-inverse);
    pointer-events: none;
  }

  .cue__label {
    opacity: 0.85;
    /* the cue is white: the shadow keeps it legible over a light photo */
    text-shadow:
      0 1px 4px rgb(0 0 0 / 0.45),
      0 0 14px rgb(0 0 0 / 0.3);
  }

  .cue__mouse {
    display: block;
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.5))
      drop-shadow(0 0 10px rgb(0 0 0 / 0.3));
  }

  .cue__wheel {
    animation: scroll-wheel 1.8s var(--dab-easing-standard) infinite;
  }

  @keyframes scroll-wheel {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    70% {
      transform: translateY(7px);
      opacity: 1;
    }
    100% {
      transform: translateY(9px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue__wheel {
      animation: none;
    }
  }
</style>
