---
/**
 * Prose wrapper: the body measure plus a reading role — `type-body` by default,
 * `type-body-lg` for a post's prose.
 *
 * Thread 3 uses it for post bodies and extends the paragraph rhythm here; no
 * other measure may be introduced. Markdown carries no classes, so headings
 * and links are mapped to components (`src/lib/prose.ts`); everything else is
 * styled by element, with tokens only.
 */
interface Props {
  class?: string;
  /** BCP 47 tag for a body written in another language than the shell. */
  lang?: string;
  /** The reading role: `body` for shell copy, `body-lg` for a post's prose. */
  type?: "body" | "body-lg";
}

const { class: className, lang, type = "body" } = Astro.props;
---

<div
  class:list={["prose", "measure", `type-${type}`, className]}
  lang={lang}
>
  <slot />
</div>

<style>
  /* The shared `.prose > * + *` rhythm never reaches the first child, so the
     page keeps owning the gap above the body. */

  /* Paragraph to paragraph takes one longer breath than the shell's 16px:
     36px, composed from the scale because the ladder has no 9 step. */
  .prose :global(p + p) {
    margin-block-start: calc(var(--dab-space-8) + var(--dab-space-1));
  }

  /* An image sits on its own beat: 48px between a figure and the text or the
     next figure around it. */
  .prose :global(p + figure),
  .prose :global(figure + p),
  .prose :global(figure + figure) {
    margin-block-start: var(--dab-space-12);
  }

  /* A subheading opens a new beat: one step above the 48 that separates text
     from a figure, so the heading reads as a break rather than another block. */
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-block-start: var(--dab-space-16);
    margin-block-end: 0;
    color: var(--dab-color-text-primary);
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *),
  .prose :global(h4 + *) {
    margin-block-start: var(--dab-space-2);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--dab-space-6);
  }

  /* Tailwind's preflight strips list markers. Prose puts them back: an
     ordered list (the references) must show its numbers, and an unordered
     list must read as a list. The marker itself stays quiet. */
  .prose :global(ul) {
    list-style: disc;
  }

  .prose :global(ol) {
    list-style: decimal;
  }

  .prose :global(li)::marker {
    color: var(--dab-color-text-tertiary);
  }

  /* A citation mark rides above the line without stretching the leading. */
  .prose :global(sup) {
    line-height: 0;
  }

  /* The mark is a link to its source: no brackets, always underlined, but in
     the text colour so the accent budget is untouched. */
  .prose :global(sup a) {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* Back-to-back marks read as one group: 5,6 rather than 56. */
  .prose :global(sup + sup)::before {
    content: ",";
  }

  /* A reference target clears the sticky header when a mark jumps to it. */
  .prose :global([id^="ref-"]) {
    scroll-margin-block-start: calc(
      var(--dab-header-height) + var(--dab-space-4)
    );
  }

  .prose :global(li + li),
  .prose :global(li > ul),
  .prose :global(li > ol) {
    margin-block-start: var(--dab-space-1);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: var(--dab-space-4);
    border-inline-start: var(--dab-border-width) solid var(--dab-color-border-strong);
    color: var(--dab-color-text-secondary);
  }

  .prose :global(hr) {
    border: 0;
    border-block-start: var(--dab-border-width) solid var(--dab-color-border);
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: var(--dab-space-4);
    border: var(--dab-border-width) solid var(--dab-color-border);
    border-radius: var(--dab-radius-md);
    background-color: var(--dab-color-surface-secondary);
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
  }

  .prose :global(:not(pre) > code) {
    padding: var(--dab-space-0-5) var(--dab-space-1);
    border: var(--dab-border-width) solid var(--dab-color-border);
    border-radius: var(--dab-radius-xs);
    background-color: var(--dab-color-surface-secondary);
  }

  .prose :global(img) {
    display: block;
    max-inline-size: 100%;
    block-size: auto;
    border: var(--dab-border-width) solid var(--dab-color-border);
    border-radius: var(--dab-radius-lg);
  }

  .prose :global(figcaption) {
    margin-block-start: var(--dab-space-2);
    color: var(--dab-color-text-tertiary);
  }

  .prose :global(table) {
    inline-size: 100%;
    border-collapse: collapse;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--dab-space-2) var(--dab-space-3);
    border-block-end: var(--dab-border-width) solid var(--dab-color-border);
    text-align: start;
  }

  .prose :global(th) {
    color: var(--dab-color-text-secondary);
    font-weight: 600;
  }
</style>
