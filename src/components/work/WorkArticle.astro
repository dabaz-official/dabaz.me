---
/**
 * One project, shared by both locale routes.
 *
 * The page takes the article page's shape and rhythm, so a reader who steps
 * from a post to a project does not feel the page move under them: the span
 * and the shipping quarter as the meta block, the name, the summary as a
 * deck, the action at the deck's 45px beat, then the cover running the
 * container. A record body — when a case study grows one — renders at the
 * prose measure underneath.
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Container from "../Container.astro";
import PillButton from "../PillButton.astro";
import WorkDetailBody from "./WorkDetailBody.astro";
import ui from "../../content/ui";
import { htmlLang, type Locale } from "../../lib/i18n";
import type { WorkDetailEntry } from "../../lib/works";

interface Props {
  entry: CollectionEntry<"works">;
  locale: Locale;
  /** The locale's case study; a project can ship its facts before its prose. */
  detail?: WorkDetailEntry;
}

const { entry, locale, detail } = Astro.props;
const { title, start, end, shipped, summary, href, cover } = entry.data;
const lang = htmlLang(locale);

/** `2025-10` reads as `2025.10`; an open end reads as now. */
const month = (value: string) => value.replace("-", ".");
const span = start
  ? `${month(start)} – ${end ? month(end) : ui.work.ongoing[locale]}`
  : undefined;
const shippedLine = shipped
  ? ui.work.shipped[locale](
      Number(shipped.slice(0, 4)),
      Number(shipped.slice(6)),
    )
  : undefined;
---

<article class="work">
  <Container>
    <header class="work__head measure">
      <div class="work__meta type-caption">
        {span && <span class="tabular" lang={lang}>{span}</span>}
        {shippedLine && <span lang={lang}>{shippedLine}</span>}
      </div>
      <h1 class="type-display" lang="en">{title}</h1>
      <p class="work__summary type-lede" lang={lang}>{summary[locale]}</p>

      {
        href && (
          <PillButton
            class="work__visit"
            href={href}
            label={ui.work.visit[locale]}
            external
          />
        )
      }
    </header>

    {
      cover && (
        <figure class="work__cover">
          <Image
            src={cover.src}
            alt={cover.alt[locale]}
            width={1600}
            height={900}
            widths={[720, 1440, 1600]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    {detail && <WorkDetailBody detail={detail} />}
  </Container>
</article>

<style>
  /* A page-owned article rather than `Section`, exactly as a post: the rhythm
     is the band's 64px, the column is centred, and the top pays 4.5px for the
     meta line's own leading so the pixels measure to 48 — the same first line
     the article page sets. */
  .work {
    padding-block-start: calc(var(--dab-space-12) - 4.5px);
    padding-block-end: var(--dab-space-16);
  }

  .work__head {
    margin-inline: auto;
    margin-block-end: var(--dab-space-12);
  }

  /* The span and the shipping quarter stack as one opening block, the way a
     post sets its date and tags: the gap is the 12px line's own leading, not a
     spacing step. */
  .work__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--dab-space-1);
    color: var(--dab-color-text-tertiary);
  }

  /* The headline picks up the space the meta used to hold, as on a post. */
  .work__head h1 {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-primary);
  }

  /* The record's summary as a deck, the same sentence the card teases with. */
  .work__summary {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* The action takes the post's share beat: 45px under the deck, which is the
     48 step less the 3px the summary's descender eats. */
  .work__head :global(.work__visit) {
    margin-block-start: calc(var(--dab-space-12) - 3px);
  }

  /* The cover runs the container, not the measure, and keeps the post's 48
     above the body. */
  .work__cover {
    margin: 0 0 var(--dab-space-12);
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface-secondary);
  }

  .work__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* `Prose` is a child component: its root carries its own scope, so the
     centring reaches it through `:global`, the documented way. */
  .work :global(.work__body) {
    margin-inline: auto;
  }
</style>
