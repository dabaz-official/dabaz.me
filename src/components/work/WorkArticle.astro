---
/**
 * One project, shared by both locale routes.
 *
 * The page takes the article page's shape and rhythm, so a reader who steps
 * from a post to a project does not feel the page move under them: the year
 * and the keywords as the meta block, the name, the summary as a deck, the
 * share marks at the deck's 45px beat, the action one step under them, then
 * the cover running the container. A record body — when a case study grows one —
 * renders at the prose measure underneath.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Container from "../Container.astro";
import PillButton from "../PillButton.astro";
import Prose from "../Prose.astro";
import ShareActions from "../ShareActions.astro";
import ShareScript from "../ShareScript.astro";
import ProseH1 from "../prose/ProseH1.astro";
import ProseH2 from "../prose/ProseH2.astro";
import ProseH3 from "../prose/ProseH3.astro";
import ProseH4 from "../prose/ProseH4.astro";
import ProseLink from "../prose/ProseLink.astro";
import ProseOl from "../prose/ProseOl.astro";
import ui from "../../content/ui";
import { htmlLang, type Locale } from "../../lib/i18n";
import { workDetailPath } from "../../lib/works";

interface Props {
  entry: CollectionEntry<"works">;
  locale: Locale;
}

/** Markdown output carries no classes; the same map the post body uses. */
const proseComponents = {
  h1: ProseH1,
  h2: ProseH2,
  h3: ProseH3,
  h4: ProseH4,
  a: ProseLink,
  ol: ProseOl,
};

const { entry, locale } = Astro.props;
const { title, year, summary, tags, href, cover } = entry.data;
const lang = htmlLang(locale);
const keywords = tags[locale].join(" · ");
const { Content } = await render(entry);
---

<article class="work">
  <Container>
    <header class="work__head measure">
      <div class="work__meta type-caption">
        {year !== undefined && (
          <time class="tabular" datetime={String(year)}>{year}</time>
        )}
        {keywords && <span lang={lang}>{keywords}</span>}
      </div>
      <h1 class="type-display" lang="en">{title}</h1>
      <p class="work__summary type-lede" lang={lang}>{summary[locale]}</p>

      <div class="work__share">
        <ShareActions
          title={title}
          locale={locale}
          path={workDetailPath(locale, entry)}
        />
      </div>

      {
        href && (
          <PillButton
            class="work__visit"
            href={href}
            label={ui.work.visit[locale]}
            external
          />
        )
      }
    </header>

    {
      cover && (
        <figure class="work__cover">
          <Image
            src={cover.src}
            alt={cover.alt[locale]}
            width={1600}
            height={900}
            widths={[720, 1440, 1600]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <Prose class="work__body" type="body-lg">
      <Content components={proseComponents} />
    </Prose>
  </Container>

  <ShareScript />
</article>

<style>
  /* A page-owned article rather than `Section`, exactly as a post: the rhythm
     is the band's 64px, the column is centred, and the top pays 4.5px for the
     meta line's own leading so the pixels measure to 48 — the same first line
     the article page sets. */
  .work {
    padding-block-start: calc(var(--dab-space-12) - 4.5px);
    padding-block-end: var(--dab-space-16);
  }

  .work__head {
    margin-inline: auto;
    margin-block-end: var(--dab-space-12);
  }

  /* Year and keywords stack as one opening block, the way a post sets its date
     and tags: the gap is the 12px line's own leading, not a spacing step. */
  .work__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--dab-space-1);
    color: var(--dab-color-text-tertiary);
  }

  /* The headline picks up the space the meta used to hold, as on a post. */
  .work__head h1 {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-primary);
  }

  /* The record's summary as a deck, the same sentence the card teases with. */
  .work__summary {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* The share marks take the post's share beat: 45px under the deck, which is
     the 48 step less the 3px the summary's descender eats, in the same 24px
     box and 12px gap a post's row uses. */
  .work__share {
    display: flex;
    align-items: center;
    gap: var(--dab-space-3);
    margin-block-start: calc(var(--dab-space-12) - 3px);
  }

  /* The action sits two spacing steps under the share row. */
  .work__head :global(.work__visit) {
    margin-block-start: var(--dab-space-10);
  }

  /* The cover runs the container, not the measure, and keeps the post's 48
     above the body. */
  .work__cover {
    margin: 0 0 var(--dab-space-12);
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface-secondary);
  }

  .work__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* `Prose` is a child component: its root carries its own scope, so the
     centring reaches it through `:global`, the documented way. */
  .work :global(.work__body) {
    margin-inline: auto;
  }
</style>
