---
/**
 * Work showcase — the project gallery on the home work band.
 *
 * One screenshot per project, one pill tab per project name, and that project's
 * summary underneath. Changing the tab cross-fades the screenshot and the
 * summary together, the way Apple's feature galleries do.
 *
 * Layout, not measurement: every panel occupies the same grid cell, and each
 * panel is a `subgrid` of the three-row shell (media, tabs, caption). The
 * caption row is therefore sized by the tallest summary, so switching tabs
 * never moves the tabs or the page.
 *
 * Progressive enhancement: the markup is a complete, readable list without
 * JavaScript — the nav is hidden and the panels stack in document order. The
 * script adds the tab behaviour only; nothing is fetched for it, and no panel
 * hides content the no-script reader cannot reach.
 *
 * The screenshots are covers of the same records `/work` renders in its grid;
 * `WorkSection` owns the home band around this component.
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import ui from "../../content/ui";
import { workPath, type Locale } from "../../lib/i18n";

interface Props {
  entries: CollectionEntry<"works">[];
  locale: Locale;
}

const { entries, locale } = Astro.props;
/** One id prefix per document; home renders this component once. */
const id = "work-showcase";
---

{
  entries.length > 0 && (
    <div class="showcase" data-showcase>
      <div class="showcase__carousel">
        <div class="showcase__nav">
          <div
            class="showcase__tabs"
            role="tablist"
            aria-label={ui.work.showcaseLabel[locale]}
          >
            {entries.map((entry, index) => (
              <button
                class="showcase__tab type-body-sm"
                type="button"
                role="tab"
                id={`${id}-tab-${index}`}
                aria-controls={`${id}-panel-${index}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-showcase-tab={index}
                lang="en"
              >
                {entry.data.title}
              </button>
            ))}
          </div>
        </div>

        {/* Steps the selection one project at a time when the tab list
            overflows. Skipped in the tab order because the tablist itself is
            the keyboard path. */}
        <button
          class="showcase__paddle showcase__paddle--prev"
          type="button"
          aria-label={ui.work.previousProjects[locale]}
          tabindex="-1"
          data-showcase-paddle="-1"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 5 8 12l7 7" />
          </svg>
        </button>
        <button
          class="showcase__paddle showcase__paddle--next"
          type="button"
          aria-label={ui.work.nextProjects[locale]}
          tabindex="-1"
          data-showcase-paddle="1"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="showcase__items">
        {entries.map((entry, index) => {
          const { title, summary, cover } = entry.data;
          return (
            <article
              class:list={["showcase__item", index === 0 && "is-active"]}
              id={`${id}-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`${id}-tab-${index}`}
              aria-hidden={index === 0 ? "false" : "true"}
              data-showcase-item={index}
            >
              <figure class="showcase__media">
                {cover && (
                  <Image
                    class="showcase__image"
                    src={cover.src}
                    alt={cover.alt[locale]}
                    width={1600}
                    height={1000}
                    widths={[640, 960, 1600]}
                    sizes="(min-width: 1024px) 960px, 100vw"
                    loading="lazy"
                    fetchpriority="low"
                  />
                )}
                {cover?.dark && (
                  <Image
                    class="showcase__image showcase__image--dark"
                    src={cover.dark}
                    alt={cover.alt[locale]}
                    width={1600}
                    height={1000}
                    widths={[640, 960, 1600]}
                    sizes="(min-width: 1024px) 960px, 100vw"
                    loading="lazy"
                    fetchpriority="low"
                  />
                )}

                {/* The medallion apple.com puts a play/pause in: a link to
                    the project's case study, with a plus for now. */}
                <a
                  class="showcase__media-action"
                  href={`${workPath(locale)}/${entry.id}`}
                  aria-label={ui.work.caseStudy[locale]}
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    aria-hidden="true"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </a>
              </figure>
              <div class="showcase__caption">
                <h3 class="type-h3 showcase__name" lang="en">
                  {title}
                </h3>
                <p class="showcase__summary">{summary[locale]}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  )
}

<style>
  /* Three rows for every panel: media, tab nav, caption. The nav is a direct
     child of the shell; the panels span all three rows and inherit the row
     sizes through `subgrid`. */
  .showcase {
    display: grid;
    grid-template-columns: 100%;
    grid-template-rows: auto auto auto;
  }

  .showcase__items {
    position: relative;
    z-index: 1;
    grid-row: 1 / -1;
    grid-column: 1;
    display: grid;
    grid-template-rows: subgrid;
  }

  /* The panels are stacked but never faded as a whole: fading two layers at
     once dips through the page background halfway through, which reads as a
     flash on a dark screenshot. Each part dissolves on its own below. */
  .showcase__item {
    grid-row: 1 / -1;
    grid-column: 1;
    display: grid;
    grid-template-rows: subgrid;
  }

  .showcase__item.is-active {
    z-index: 1;
  }

  /* The incoming screenshot fades in over the outgoing one, which stays fully
     opaque underneath until the fade is done and then drops in one step —
     invisible, because by then it is covered. That is a dissolve, not a dip. */
  .showcase__media {
    position: relative;
    grid-row: 1;
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: clip;
    border: var(--dab-border-width) solid var(--dab-color-border);
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface-secondary);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0s var(--dab-duration-slower),
      visibility 0s var(--dab-duration-slower);
  }

  .showcase__item.is-active .showcase__media {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dab-duration-slower) var(--dab-easing-standard);
  }

  .showcase__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* A work ships one capture per theme; the dark one replaces the light one
     when the document flips. A record without a dark capture keeps its single
     image in both themes (Cyclic is dark-only). The hidden capture stays
     `lazy`, so the theme that is not in use does not download it. */
  .showcase__image--dark {
    display: none;
  }

  /* Bottom-right medallion, 20px in from the edge, on the same translucent
     scrim apple.com uses for its play/pause button. Like that button it has
     no border: the scrim carries its own contrast, so it reads over a light
     capture and a dark one without a hairline. */
  .showcase__media-action {
    position: absolute;
    inset-block-end: var(--dab-space-5);
    inset-inline-end: var(--dab-space-5);
    display: grid;
    place-items: center;
    inline-size: var(--dab-target-min);
    block-size: var(--dab-target-min);
    padding: 0;
    border: 0;
    border-radius: var(--dab-radius-full);
    background-color: var(--dab-media-scrim);
    color: var(--dab-media-scrim-text);
    text-decoration: none;
    transition:
      background-color var(--dab-duration-slower) var(--dab-easing-standard),
      color var(--dab-duration-slower) var(--dab-easing-standard),
      transform var(--dab-duration-slower) var(--dab-easing-standard);
  }

  /* The glyph keeps the ratio of apple.com's 36px button with its 36px mask:
     24px in a 44px medallion. */
  .showcase__media-action svg {
    inline-size: var(--dab-size-icon-lg);
    block-size: auto;
  }

  .showcase__media-action:hover {
    background-color: var(--dab-media-scrim-hover);
    color: var(--dab-media-scrim-text-hover);
  }

  .showcase__media-action:active {
    background-color: var(--dab-media-scrim-active);
    transform: scale(0.95);
  }

  html[data-theme="dark"] .showcase__image {
    display: none;
  }

  html[data-theme="dark"] .showcase__image--dark {
    display: block;
  }

  /* The outgoing summary leaves in one step and the incoming one fades in:
     two half-transparent paragraphs over each other would ghost. */
  .showcase__caption {
    grid-row: 3;
    max-inline-size: var(--dab-measure);
    margin-inline: auto;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: none;
  }

  .showcase__item.is-active .showcase__caption {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dab-duration-slow) var(--dab-easing-standard);
  }

  /* With scripting on, the tab above already names the project, so the
     heading would only repeat it. It stays in the document for the stacked
     no-script view, where there is no nav to carry the name. */
  html.js .showcase__name {
    display: none;
  }

  .showcase__name {
    margin: 0;
    color: var(--dab-color-text-primary);
  }

  .showcase__summary {
    margin: 0;
    color: var(--dab-color-text-secondary);
  }

  /* The pill sits in a positioning context so the paddles can overlay its
     ends without scrolling with the tabs. */
  .showcase__carousel {
    position: relative;
    grid-row: 2;
    grid-column: 1;
    z-index: 2;
    margin-block: var(--dab-space-6);
  }

  .showcase__nav {
    /* Paddle plus one gutter: content fades over the paddle's whole footprint,
       so no half-letter is left peeking beside it. */
    --showcase-fade: calc(var(--dab-target-min) + var(--dab-space-4));

    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--showcase-fade);
    scrollbar-width: none;
  }

  /* The fade only exists on a side that still has tabs beyond it, and it is
     fully transparent under the paddle itself: the tabs fade in over the
     gutter just past it, so nothing sits under the chevron. The mask lives on
     the scroller because its box is the visible area; on the content it would
     fade past the clip. */
  .showcase__carousel[data-fade-start="true"] .showcase__nav {
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      transparent var(--dab-target-min),
      black var(--showcase-fade),
      black 100%
    );
  }

  .showcase__carousel[data-fade-end="true"] .showcase__nav {
    mask-image: linear-gradient(
      90deg,
      black 0,
      black calc(100% - var(--showcase-fade)),
      transparent calc(100% - var(--dab-target-min)),
      transparent 100%
    );
  }

  .showcase__carousel[data-fade-start="true"][data-fade-end="true"]
    .showcase__nav {
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      transparent var(--dab-target-min),
      black var(--showcase-fade),
      black calc(100% - var(--showcase-fade)),
      transparent calc(100% - var(--dab-target-min)),
      transparent 100%
    );
  }

  .showcase__nav::-webkit-scrollbar {
    display: none;
  }

  /* A paddle shows only on a side that still has tabs beyond the edge, so it
     never covers the first or last tab in a list that already fits, and never
     offers a step it cannot take. 44×44 wide for touch; its scrim restores the
     track the mask above has faded. */
  .showcase__paddle {
    position: absolute;
    inset-block: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    inline-size: var(--dab-target-min);
    padding: 0;
    border: 0;
    /* A bare reset: without it the platform button style can add its own
       bevel or shadow. */
    appearance: none;
    box-shadow: none;
    background-color: transparent;
    color: var(--dab-color-text-secondary);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dab-duration-fast) var(--dab-easing-linear),
      visibility 0s var(--dab-duration-fast);
  }

  /* The scrim reproduces the pill's own end — a semicircle on the outside,
     then the track fading inward — instead of a disc floating on it. */
  .showcase__paddle--prev {
    inset-inline-start: 0;
    border-start-start-radius: var(--dab-radius-pill);
    border-end-start-radius: var(--dab-radius-pill);
    background-image: linear-gradient(
      90deg,
      var(--dab-color-surface) 0,
      var(--dab-color-surface) 55%,
      transparent 100%
    );
  }

  .showcase__paddle--next {
    inset-inline-end: 0;
    border-start-end-radius: var(--dab-radius-pill);
    border-end-end-radius: var(--dab-radius-pill);
    background-image: linear-gradient(
      270deg,
      var(--dab-color-surface) 0,
      var(--dab-color-surface) 55%,
      transparent 100%
    );
  }

  .showcase__paddle:hover {
    color: var(--dab-color-text-primary);
  }

  .showcase__carousel[data-fade-start="true"] .showcase__paddle--prev,
  .showcase__carousel[data-fade-end="true"] .showcase__paddle--next {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .showcase__tabs {
    position: relative;
    display: flex;
    inline-size: fit-content;
    margin-inline: auto;
    padding: var(--dab-space-1);
    border-radius: var(--dab-radius-pill);
    background-color: var(--dab-color-surface);
  }

  /* One sliding pill behind the labels; the script writes the two vars. */
  .showcase__tabs::before {
    content: "";
    position: absolute;
    inset-block: var(--dab-space-1);
    left: var(--showcase-indicator-left, var(--dab-space-1));
    width: var(--showcase-indicator-width, 0px);
    border-radius: var(--dab-radius-pill);
    background-color: var(--dab-color-primary);
  }

  .showcase__tabs.is-animatable::before {
    transition:
      left var(--dab-duration-slow) var(--dab-easing-standard),
      width var(--dab-duration-slow) var(--dab-easing-standard);
  }

  .showcase__tab {
    position: relative;
    z-index: 1;
    min-block-size: var(--dab-target-min);
    padding-inline: var(--dab-space-4);
    border: 0;
    border-radius: var(--dab-radius-pill);
    background-color: transparent;
    color: var(--dab-color-text-secondary);
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--dab-duration-base) var(--dab-easing-standard);
  }

  .showcase__tab:hover {
    color: var(--dab-color-text-primary);
  }

  .showcase__tab[aria-selected="true"] {
    color: var(--dab-color-on-primary);
    cursor: auto;
  }

  /* No script: the nav cannot do anything, so it leaves and the panels stack
     as a plain list of screenshot plus summary. */
  html:not(.js) .showcase__carousel {
    display: none;
  }

  html:not(.js) .showcase__items {
    display: block;
  }

  html:not(.js) .showcase__item {
    display: block;
  }

  html:not(.js) .showcase__item + .showcase__item {
    margin-block-start: var(--dab-space-10);
  }

  html:not(.js) .showcase__media,
  html:not(.js) .showcase__caption {
    opacity: 1;
    visibility: visible;
  }

  html:not(.js) .showcase__caption {
    grid-row: auto;
  }

  html:not(.js) .showcase__summary {
    margin-block-start: var(--dab-space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__nav {
      scroll-behavior: auto;
    }

    .showcase__paddle,
    .showcase__media-action,
    .showcase__media,
    .showcase__item.is-active .showcase__media,
    .showcase__caption,
    .showcase__item.is-active .showcase__caption,
    .showcase__tabs.is-animatable::before {
      transition: none;
    }

    .showcase__media-action:active {
      transform: none;
    }
  }
</style>

<script>
  /**
   * The showcase's tab behaviour. Everything it needs is already in the
   * document: it toggles classes and attributes, positions the one indicator,
   * and does not fetch or render anything.
   */
  for (const root of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-showcase-tab]"),
    );
    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-showcase-item]"),
    );
    const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
    const nav = root.querySelector<HTMLElement>(".showcase__nav");
    const carousel = root.querySelector<HTMLElement>(".showcase__carousel");
    const paddles = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-showcase-paddle]"),
    );

    if (!tablist || tabs.length === 0 || tabs.length !== items.length) continue;

    let active = tabs.findIndex(
      (tab) => tab.getAttribute("aria-selected") === "true",
    );
    if (active < 0) active = 0;

    const placeIndicator = () => {
      const tab = tabs[active];
      if (!tab) return;
      tablist.style.setProperty(
        "--showcase-indicator-left",
        `${tab.offsetLeft}px`,
      );
      tablist.style.setProperty(
        "--showcase-indicator-width",
        `${tab.offsetWidth}px`,
      );
    };

    // One state on the carousel: which sides have tabs beyond the visible
    // edge. It drives both the mask and whether that paddle is offered.
    const syncState = () => {
      if (!nav || !carousel) return;
      const overflow = nav.scrollWidth > nav.clientWidth + 1;

      carousel.dataset.fadeStart = String(overflow && nav.scrollLeft > 1);
      carousel.dataset.fadeEnd = String(
        overflow && nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 1,
      );
    };

    const revealActive = () => {
      tabs[active]?.scrollIntoView({ block: "nearest", inline: "nearest" });
    };

    const select = (index: number, moveFocus = false) => {
      active = (index + tabs.length) % tabs.length;

      tabs.forEach((tab, position) => {
        const selected = position === active;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });

      items.forEach((item, position) => {
        const selected = position === active;
        item.classList.toggle("is-active", selected);
        item.setAttribute("aria-hidden", String(!selected));
      });

      if (moveFocus) tabs[active]?.focus();
      placeIndicator();
      syncState();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        select(index);
        // A tab revealed by the paddles can be half under one of them.
        revealActive();
      });
    });

    for (const paddle of paddles) {
      paddle.addEventListener("click", () => {
        const direction = Number(paddle.dataset.showcasePaddle);
        if (!direction) return;

        // One project per press, and never around the ends: a hidden paddle
        // is unclickable, but the handler still refuses to wrap.
        const target = active + direction;
        if (target < 0 || target >= tabs.length) return;

        select(target);
        revealActive();
      });
    }

    tablist.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        return;
      }

      event.preventDefault();

      if (event.key === "Home") select(0, true);
      else if (event.key === "End") select(tabs.length - 1, true);
      else select(active + (event.key === "ArrowRight" ? 1 : -1), true);

      revealActive();
    });

    select(active);

    if (nav) nav.addEventListener("scroll", syncState, { passive: true });
    requestAnimationFrame(() => tablist.classList.add("is-animatable"));

    const replace = () => {
      placeIndicator();
      syncState();
    };
    const observer = new ResizeObserver(replace);
    observer.observe(tablist);
    if (nav) observer.observe(nav);
    void document.fonts.ready.then(replace);
  }
</script>
