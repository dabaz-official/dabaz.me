---
/**
 * Work — the card list of shipped projects on `/work`.
 *
 * The writing list sets the form: a 16:9 cover flush inside a rounded
 * surface, then four text rows — the keywords, the project name, the summary
 * and the year, the year holding the card's bottom.
 *
 * A row of cards shares its tracks: the cover and the four text rows are rows
 * of the grid, and every card in the row spans the same tracks through
 * `subgrid`. A one-line name therefore leaves the room its neighbour's
 * two-line name needs, and every summary and year starts on the same line
 * across the row. Below 640 there is one card per row, so each card sizes its
 * own tracks and no space is reserved.
 *
 * The whole card is the link, to the project's page on this site
 * (`/work/<id>`); the record's own URL is that page's action.
 */
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import ui from "../../content/ui";
import { htmlLang, type Locale } from "../../lib/i18n";
import { workDetailPath } from "../../lib/works";

interface Props {
  entries: CollectionEntry<"works">[];
  locale: Locale;
  /** `h3` under the home band's `h2`; `h2` under the page's `h1`. */
  heading?: "h2" | "h3";
}

const { entries, locale, heading: Heading = "h3" } = Astro.props;
---

<ul class="cards">
  {
    entries.map((entry) => {
      const { title, tags, summary, year, cover } = entry.data;
      const keywords =
        tags[locale].length > 0 ? tags[locale].join(" · ") : ui.nav.work[locale];
      return (
        <li class="card">
          <a class="card__frame" href={workDetailPath(locale, entry)}>
            <div class="card__media">
              {cover && (
                <Image
                  class="card__image"
                  src={cover.src}
                  alt=""
                  width={1600}
                  height={900}
                  widths={[480, 800, 1600]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              )}
              {cover?.dark && (
                <Image
                  class="card__image card__image--dark"
                  src={cover.dark}
                  alt=""
                  width={1600}
                  height={900}
                  widths={[480, 800, 1600]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              )}
            </div>
            <p class="card__eyebrow type-label-caps" lang={htmlLang(locale)}>
              {keywords}
            </p>
            <Heading class="card__title type-h4" lang="en">
              {title}
            </Heading>
            <p class="card__summary type-body-sm" lang={htmlLang(locale)}>
              {summary[locale]}
            </p>
            {year !== undefined && (
              <p class="card__year type-caption tabular">
                <time datetime={String(year)}>{year}</time>
              </p>
            )}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--dab-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--dab-space-8);
    }
  }

  /* The card spans one row's worth of tracks — cover, keywords, name,
     summary, year — so its neighbours in the row size those tracks with it.
     The surface and the clip sit here, on the grid item: the frame inside is
     a subgrid, and the clip is what rounds the cover. */
  .card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface);
  }

  /* The frame fills the card, so its own focus ring would sit outside the
     card's clip and never show; the card draws the ring in its place, round
     its radius. */
  .card:has(.card__frame:focus-visible) {
    outline: 2px solid var(--dab-color-focus);
    outline-offset: 2px;
  }

  /* The frame spans the whole card and lays the five rows out through the
     card's tracks. A subgrid inherits the list's gap, so a frame would sit
     its rows `space-8` apart; the text rows space themselves, so it takes no
     gap of its own. */
  .card__frame {
    grid-row: 1 / -1;
    display: grid;
    grid-template-rows: subgrid;
    row-gap: 0;
    color: inherit;
    text-decoration: none;
  }

  /* The media box owns the ratio: whatever image lands here is cropped to
     16:9. No radius of its own — the card's clip does that. */
  .card__media {
    aspect-ratio: 16 / 9;
    overflow: clip;
    background-color: var(--dab-color-surface-secondary);
  }

  .card__image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--dab-duration-slow) var(--dab-easing-standard);
  }

  /* The writing card's hover: the cover eases in a little, the text stays. */
  .card__frame:hover .card__image {
    scale: 1.03;
  }

  /* One capture per theme; the dark one takes over when the document flips.
     Records without a dark capture keep their single image in both. */
  .card__image--dark {
    display: none;
  }

  html[data-theme="dark"] .card__image {
    display: none;
  }

  html[data-theme="dark"] .card__image--dark {
    display: block;
  }

  /* Every text row carries the card's inset; the vertical spacing between
     rows is the row's own padding-block-start, because the shared tracks
     leave no gap to spend. */
  .card__eyebrow,
  .card__title,
  .card__summary,
  .card__year {
    padding-inline: var(--dab-space-6);
  }

  .card__eyebrow {
    margin: 0;
    padding-block-start: var(--dab-space-6);
    color: var(--dab-color-text-tertiary);
  }

  .card__title {
    margin: 0;
    padding-block-start: var(--dab-space-2);
    color: var(--dab-color-text-primary);
    text-wrap: balance;
  }

  .card__summary {
    margin: 0;
    padding-block-start: var(--dab-space-2);
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* The year holds the bottom of the card. */
  .card__year {
    margin: 0;
    padding-block-start: var(--dab-space-4);
    padding-block-end: var(--dab-space-6);
    color: var(--dab-color-text-tertiary);
  }

  @media (prefers-reduced-motion: reduce) {
    .card__image {
      transition: none;
    }

    .card__frame:hover .card__image {
      scale: none;
    }
  }
</style>
