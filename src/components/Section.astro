---
/**
 * A page section: the container plus the section rhythm.
 *
 * `spacing` is the only knob, because the rhythm is a design decision:
 *   - `standard` — `space-16` above and below (DESIGN.md §5);
 *   - `loose`    — `space-24` above from 640, the hero-to-content transition;
 *   - `none`     — no padding; the consumer owns it.
 *
 * The bottom padding belongs here rather than on each page: a class passed to
 * this component carries this component's scope, so a page's own
 * `.page { padding-block-end }` rule would never match.
 */
import Container from "./Container.astro";

interface Props {
  as?: "section" | "article" | "div";
  spacing?: "standard" | "loose" | "none";
  id?: string;
  labelledby?: string;
  class?: string;
}

const {
  as: Tag = "section",
  spacing = "standard",
  id,
  labelledby,
  class: className,
} = Astro.props;
---

<Tag
  id={id}
  class:list={["section", className]}
  data-spacing={spacing}
  aria-labelledby={labelledby}
>
  <Container>
    <slot />
  </Container>
</Tag>

<style>
  .section {
    padding-block: var(--dab-space-16);
  }

  .section[data-spacing="none"] {
    padding-block: 0;
  }

  @media (min-width: 640px) {
    .section[data-spacing="loose"] {
      padding-block-start: var(--dab-space-24);
    }
  }
</style>
