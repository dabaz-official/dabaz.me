---
/**
 * The site header: the mark, the section nav, glass. There is no rule under
 * the bar — the scrim alone separates it from the page — and on the home it
 * fades from the band tone to white once the first screen is behind.
 *
 * Sticky at every width; the scrim is the only translucent surface on the
 * site (DESIGN.md §7.1, AGENTS.md → Exceptions). Every nav item points at a
 * real page, so the header never depends on a home anchor or a section
 * existing.
 */
import Container from "./Container.astro";
import ui from "../content/ui";
import site from "../data/site";
import {
  contactPath,
  defaultLocale,
  homePath,
  musicPath,
  type Locale,
  workPath,
} from "../lib/i18n";
import { writingPath } from "../lib/writing";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<header class="site-header">
  <Container class="site-header__inner">
    <a
      class="logo"
      href={homePath(locale)}
      aria-label={ui.home.logo[locale](site.name)}
    >
      <svg
        class="logo__mark"
        viewBox="0 0 360 360"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M24.1155 90C39.9137 62.6366 62.6366 39.9137 90 24.1155C117.363 8.31721 148.403 0 180 0C211.597 0 242.636 8.3171 270 24.1153C297.364 39.9136 320.087 62.6364 335.884 89.9998C351.682 117.364 360 148.404 360 180C360 211.597 351.682 242.636 335.885 270L180 180V360C148.404 360 117.364 351.682 90.0002 335.885C62.6366 320.087 39.9137 297.364 24.1155 270C8.31721 242.636 0 211.597 0 180C0 148.404 8.3171 117.364 24.1155 90Z"
          fill="currentColor"
          fill-rule="evenodd"
          clip-rule="evenodd"
        />
      </svg>
    </a>

    <nav class="site-nav" aria-label={ui.primaryNav[locale]}>
      <ul class="site-nav__list type-caption">
        <li><a href={workPath(locale)}>{ui.nav.work[locale]}</a></li>
        <li><a href={musicPath(locale)}>{ui.nav.music[locale]}</a></li>
        <li><a href={contactPath(locale)}>{ui.nav.contact[locale]}</a></li>
        <li><a href={writingPath(locale)}>{ui.nav.writing[locale]}</a></li>
      </ul>
    </nav>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background-color: var(--dab-header-bg);
    /* The home flips `data-past` once the first screen is behind; the fade is
       time-based, which a scroll timeline cannot express. Alpha is 0.82 at
       both ends, so the bar never stops being glass. */
    transition: background-color var(--dab-duration-slower) var(--dab-easing-standard);
    -webkit-backdrop-filter: var(--dab-header-blur);
    backdrop-filter: var(--dab-header-blur);
  }

  /* The bar keeps the page tone from the first scroll on: an opaque bar that
     changes colour is just a colour change, and these clients asked for less
     transparency, not for a themed bar. */
  .site-header[data-past] {
    background-color: var(--dab-header-bg-past);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-header,
    .site-header[data-past] {
      background-color: var(--dab-color-background);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header,
    .site-header[data-past] {
      background-color: var(--dab-color-background);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* `Container` renders this element; `:global()` is the documented way to
     style a child component's root (src/CONVENTIONS.md §7). */
  :global(.site-header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--dab-space-4);
    min-block-size: var(--dab-header-height);
  }

  .logo {
    /* Caption-sized nav text (12px) sets the mark's scale: 24px is a clean
       2× the text size and keeps the mark reading as a mark, not a headline. */
    --logo-size: 24px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--dab-target-min);
    block-size: var(--dab-target-min);
    /* the 44px target is wider than the mark: keep the mark on the shell edge */
    margin-inline-start: calc((var(--dab-target-min) - var(--logo-size)) / -2);
    color: var(--dab-color-text-primary);
    text-decoration: none;
  }

  .logo__mark {
    display: block;
    inline-size: var(--logo-size);
    block-size: var(--logo-size);
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--dab-space-2);
    margin: 0;
    /* the last item's padding would push its text off the shell edge */
    margin-inline-end: calc(var(--dab-space-2) * -1);
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--dab-target-min);
    padding-inline: var(--dab-space-2);
    border-radius: var(--dab-radius-sm);
    color: var(--dab-color-text-secondary);
    text-decoration: none;
    transition: color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .site-nav a:hover {
    color: var(--dab-color-text-primary);
  }

  /* Four items plus the mark do not fit at 320 with 8px padding. */
  @media (max-width: 350px) {
    .site-nav__list {
      gap: var(--dab-space-1);
      margin-inline-end: calc(var(--dab-space-1) * -1);
    }

    .site-nav a {
      padding-inline: var(--dab-space-1);
    }
  }
</style>
