---
/**
 * Image wrapper: `astro:assets` with explicit dimensions, a required `alt`,
 * and the shared 1px + `radius-lg` frame (DESIGN.md §9).
 *
 * Sources are local imports, so Astro has the intrinsic size at build time.
 * Pass `widths` and `sizes` when the image is responsive.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  /** Meaningful text; pass `""` only when the image is decorative. */
  alt: string;
  /** Rendered width in CSS pixels; required to keep layout shift at zero. */
  width: number;
  /** Rendered height in CSS pixels; must match the source ratio. */
  height: number;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  loading = "lazy",
  class: className,
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  class:list={["image-frame", className]}
/>
