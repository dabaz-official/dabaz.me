---
/**
 * The page shell: `container-lg` with the core §7 gutters.
 * Props are semantic; it takes no width or spacing value.
 */
interface Props {
  as?: "div" | "section" | "header" | "footer" | "main" | "nav";
  class?: string;
}

const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["container-shell", className]}>
  <slot />
</Tag>
