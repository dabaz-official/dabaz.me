---
/**
 * A figure inside a post body: the shared image frame plus an optional caption.
 *
 * The rendered width is the prose measure: 36em at the post's `type-body-lg`,
 * which is 648. The source is imported by the MDX file, so `astro:assets` has
 * the intrinsic ratio and the width/height couple keeps layout shift at zero.
 */
import type { ImageMetadata } from "astro";
import ContentImage from "../ContentImage.astro";

interface Props {
  src: ImageMetadata;
  /** Meaningful description of the image for assistive technology. */
  alt: string;
  /** Visible caption, usually the original article's caption or credit. */
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const width = 648;
const height = Math.round((width * src.height) / src.width);
---

<figure class="post-figure">
  <ContentImage
    src={src}
    alt={alt}
    width={width}
    height={height}
    widths={[648, 1296]}
    sizes="(min-width: 640px) 648px, 100vw"
  />
  {caption && <figcaption class="type-caption">{caption}</figcaption>}
</figure>

<style>
  /* A figure opens and closes one step wider than the paragraph rhythm: 24
     against the prose's 16. */
  .post-figure {
    margin-block: var(--dab-space-6);
  }

  /* A caption sits under the frame, one size down from the prose. */
  figcaption {
    margin-block-start: var(--dab-space-2);
    color: var(--dab-color-text-tertiary);
    text-wrap: pretty;
  }
</style>
