---
/**
 * The pill that closes a writing surface: `Read more`, back to the list.
 *
 * A post's related shelf and a tag page offer the same action, so the label
 * and the destination live here once, on the shared `PillButton`. The caller
 * owns the placement: the post centres it in its measure, the tag page in its
 * foot row.
 */
import PillButton from "../PillButton.astro";
import ui from "../../content/ui";
import type { Locale } from "../../lib/i18n";

interface Props {
  href: string;
  locale: Locale;
}

const { href, locale } = Astro.props;
---

<PillButton href={href} label={ui.writing.readMore[locale]} />
