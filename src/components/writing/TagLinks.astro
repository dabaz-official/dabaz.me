---
/**
 * Tag links — `type-caption` in an ink pill, the same fill the home's
 * "View All" button wears. They are navigation, not status; the label carries
 * the meaning and the fill carries the affordance. Chips grow to the 44px
 * touch target on coarse pointers.
 *
 * The tag string is author copy and is not translated by the locale: only the
 * route prefix follows the post's locale.
 */
import type { Locale } from "../../lib/i18n";
import { tagPath } from "../../lib/writing";

interface Props {
  tags: string[];
  locale: Locale;
  class?: string;
}

const { tags, locale, class: className } = Astro.props;
---

<ul class:list={["tag-list", "type-caption", className]}>
  {
    tags.map((tag) => (
      <li>
        <a class="tag" href={tagPath(tag, locale)}>
          {tag}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dab-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--dab-space-1) var(--dab-space-3);
    border-radius: var(--dab-radius-pill);
    background-color: var(--dab-color-primary);
    color: var(--dab-color-on-primary);
    text-decoration: none;
    transition: background-color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .tag:hover {
    background-color: var(--dab-color-primary-hover);
  }

  @media (pointer: coarse) {
    .tag {
      min-block-size: var(--dab-target-min);
      padding-inline: var(--dab-space-3);
    }
  }
</style>
