---
/**
 * Tag links — `type-caption` in a 1px chip (DESIGN.md §7.7). They are
 * navigation, not status, so they carry a boundary; colour never carries the
 * meaning. Chips grow to the 44px touch target on coarse pointers.
 */
import { tagPath } from "../../lib/writing";

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<ul class:list={["tag-list", "type-caption", className]}>
  {
    tags.map((tag) => (
      <li>
        <a class="tag" href={tagPath(tag)}>
          {tag}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--dab-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: var(--dab-space-1) var(--dab-space-2);
    border: var(--dab-border-width) solid var(--dab-color-border);
    border-radius: var(--dab-radius-xs);
    color: var(--dab-color-text-secondary);
    text-decoration: none;
    transition:
      color var(--dab-duration-fast) var(--dab-easing-linear),
      border-color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .tag:hover {
    border-color: var(--dab-color-border-strong);
    color: var(--dab-color-text-primary);
  }

  @media (pointer: coarse) {
    .tag {
      min-block-size: var(--dab-target-min);
      padding-inline: var(--dab-space-3);
    }
  }
</style>
