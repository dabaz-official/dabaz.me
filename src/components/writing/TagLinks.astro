---
/**
 * Tag links — the post's metadata, not controls in chrome: `type-caption`
 * plain text under the locale's tag route, a slash between them, and an
 * underline only on hover. The separator is deliberately not one the brand
 * already uses. On coarse pointers each link still takes a 44px target.
 *
 * The tag string is author copy and is not translated by the locale: only the
 * route prefix follows the post's locale.
 */
import type { Locale } from "../../lib/i18n";
import { tagPath } from "../../lib/writing";

interface Props {
  tags: string[];
  locale: Locale;
  class?: string;
}

const { tags, locale, class: className } = Astro.props;
---

<ul class:list={["tag-list", "type-caption", className]}>
  {
    tags.map((tag) => (
      <li>
        <a class="tag" href={tagPath(tag, locale)}>
          {tag}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
    transition: color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .tag:hover {
    color: var(--dab-color-text-primary);
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .tag-list li + li::before {
    content: "/";
    margin-inline: var(--dab-space-2);
    color: var(--dab-color-text-tertiary);
  }

  @media (pointer: coarse) {
    .tag {
      min-block-size: var(--dab-target-min);
    }
  }
</style>
