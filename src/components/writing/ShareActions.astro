---
/**
 * A post's two share actions: the X intent link and the copy-link button.
 *
 * A post renders them twice — the quiet marks under the deck, and the
 * `Share article` block that closes the body — so the glyphs, the intent URL,
 * and the copied state live here once. Both rows use the same 24px box and the
 * same 12px gap, so the two read as the same element at the top and the end of
 * the article; the 44px target rides on a pseudo-element and takes no space.
 *
 * The copy behaviour is `PostArticle`'s one inline script, which finds every
 * `[data-copy-link]` on the page; this component renders the markup it
 * enhances, and both actions work as plain links with scripting off.
 */
import ui from "../../content/ui";
import site from "../../data/site";
import { postPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
const { title, locale } = entry.data;
const canonical = new URL(postPath(entry), site.url).href;
const shareHref = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`;
---

<a
  class="share-action"
  href={shareHref}
  target="_blank"
  rel="noreferrer"
  aria-label={ui.writing.shareX[locale]}
>
  <svg
    class="share-action__icon"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M21.742 21.75L14.179 10.571L21.235 2.25H18.779L13.088 8.964L8.548 2.25H2.359L9.649 13.026L2.25 21.75H4.706L10.741 14.632L15.559 21.75H21.75H21.742ZM7.739 3.818L18.81 20.182H16.363L5.29 3.818H7.737H7.739Z"
      fill="currentColor"
    />
  </svg>
</a>
<button
  class="share-action"
  type="button"
  data-copy-link
  aria-label={ui.writing.copyLink[locale]}
  data-copied-label={ui.writing.copied[locale]}
>
  <svg
    class="share-action__icon share-action__icon--link"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M9 15l6 -6" />
    <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
    <path
      d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463"
    />
  </svg>
  <svg
    class="share-action__icon share-action__icon--check"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M5 12l5 5l10 -10" />
  </svg>
</button>

<style>
  /* The mark alone: no chrome, quiet at rest, ink on hover — the header nav's
     own colour pair. */
  .share-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* The box is the 24px mark, so the gap set by the row is the gap you see;
       the 44px target rides on a pseudo-element that takes pointer events
       without taking space. */
    inline-size: var(--dab-size-icon-lg);
    block-size: var(--dab-size-icon-lg);
    padding: 0;
    border: 0;
    background: none;
    color: var(--dab-color-text-secondary);
    cursor: pointer;
    transition: color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .share-action::after {
    content: "";
    position: absolute;
    inset: calc((var(--dab-size-icon-lg) - var(--dab-target-min)) / 2);
  }

  .share-action:hover {
    color: var(--dab-color-text-primary);
  }

  .share-action__icon {
    display: block;
    inline-size: var(--dab-size-icon-lg);
    block-size: var(--dab-size-icon-lg);
  }

  /* The copy button answers by turning into a check for two seconds. */
  .share-action__icon--check {
    display: none;
  }

  .share-action[data-copied] .share-action__icon--link {
    display: none;
  }

  .share-action[data-copied] .share-action__icon--check {
    display: block;
  }
</style>
