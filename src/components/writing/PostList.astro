---
/**
 * The writing list. Rows share their hairlines, so the list closes the last
 * one with a bottom border (DESIGN.md §7.5).
 */
import type { WritingEntry } from "../../lib/writing";
import PostRow from "./PostRow.astro";

interface Props {
  entries: WritingEntry[];
  headingLevel?: "h2" | "h3";
  showTags?: boolean;
  class?: string;
}

const {
  entries,
  headingLevel,
  showTags,
  class: className,
} = Astro.props;
---

<ol class:list={["post-list", className]}>
  {
    entries.map((entry) => (
      <li>
        <PostRow
          entry={entry}
          headingLevel={headingLevel}
          showTags={showTags}
        />
      </li>
    ))
  }
</ol>

<style>
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-end: var(--dab-border-width) solid var(--dab-color-border);
  }
</style>
