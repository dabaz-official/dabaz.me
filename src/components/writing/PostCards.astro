---
/**
 * Writing cards — the home shelf and the list pages share one component.
 *
 * The card is the link: a 16:9 cover flush inside a rounded surface, then the
 * eyebrow, headline and date. The cover is the record's own when it has one,
 * and a neutral placeholder until the rest of the archive grows one; the card
 * always crops to 16:9, so either shape works.
 *
 * The body is a column with the date pushed down by `margin-block-start: auto`:
 * in a row of equal-height cards, every date then sits on the same baseline
 * whether the headline runs one line or three.
 */
import { Image } from "astro:assets";
import placeholder from "../../assets/writing/placeholder-16x9.svg";
import ui from "../../content/ui";
import { dateTime, formatLongDate } from "../../lib/dates";
import { defaultLocale, htmlLang, type Locale } from "../../lib/i18n";
import { postPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entries: WritingEntry[];
  locale?: Locale;
  /** `three` is the home shelf; `two` is the list and tag pages. */
  columns?: "two" | "three";
  /** The list pages carry the headline's summary; the shelf does not. */
  showSummary?: boolean;
  headingLevel?: "h2" | "h3";
  class?: string;
}

const {
  entries,
  locale = defaultLocale,
  columns = "two",
  showSummary = false,
  headingLevel: Heading = "h2",
  class: className,
} = Astro.props;
---

<ul class:list={["cards", `cards--${columns}`, className]}>
  {
    entries.map((entry) => {
      const { title, date, tags, summary, cover, locale: postLocale } =
        entry.data;
      const lang = htmlLang(postLocale);
      const eyebrow = tags[0] ?? ui.nav.writing[locale];
      return (
        <li class="card">
          <a class="card__link" href={postPath(entry)}>
            <span class="card__media">
              {cover ? (
                <Image
                  src={cover.src}
                  alt={cover.alt}
                  width={1920}
                  height={1080}
                  widths={[480, 960, 1920]}
                  sizes={
                    columns === "three"
                      ? "(min-width: 1024px) 300px, 50vw"
                      : "(min-width: 640px) 460px, 100vw"
                  }
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <img
                  src={placeholder.src}
                  alt=""
                  width="1920"
                  height="1080"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </span>
            <span class="card__body">
              <span class="card__eyebrow type-label-caps">{eyebrow}</span>
              <Heading class="card__title type-h4" lang={lang}>
                {title}
              </Heading>
              {showSummary && (
                <span class="card__summary type-body-sm" lang={lang}>
                  {summary}
                </span>
              )}
              <time
                class="card__date type-caption tabular"
                datetime={dateTime(date)}
              >
                {formatLongDate(date, locale)}
              </time>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  /* One card per row on a phone: at 343px a half-width card leaves about
     140px for the headline, which breaks titles into three-word lines. */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--dab-space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .cards--two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--dab-space-8);
    }

    .cards--three {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Three across from the wide breakpoint: the shelf shows exactly the three
     newest posts, so one row is the whole section. */
  @media (min-width: 1024px) {
    .cards--three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--dab-space-8);
    }
  }

  .card {
    display: grid;
  }

  .card__link {
    display: grid;
    grid-template-rows: auto 1fr;
    block-size: 100%;
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface);
    color: inherit;
    text-decoration: none;
  }

  /* The media box owns the ratio: whatever image lands here is cropped to
     16:9. No radius of its own — the card's clip does that. */
  .card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: clip;
    background-color: var(--dab-color-surface-secondary);
  }

  .card__media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: scale var(--dab-duration-slow) var(--dab-easing-standard);
  }

  .card__link:hover .card__media :global(img) {
    scale: 1.03;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--dab-space-2);
    padding: var(--dab-space-6);
  }

  .card__eyebrow {
    color: var(--dab-color-text-tertiary);
  }

  .card__title {
    margin: 0;
    color: var(--dab-color-text-primary);
    text-wrap: balance;
  }

  .card__summary {
    margin: 0;
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* The date holds the bottom of the card, so a one-line headline still leaves
     the room its neighbour's two-line headline needs. */
  .card__date {
    margin-block-start: auto;
    padding-block-start: var(--dab-space-2);
    color: var(--dab-color-text-tertiary);
  }
</style>
