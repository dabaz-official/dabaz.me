---
/**
 * One post body, shared by both locale routes.
 *
 * The page owns the only `h1`; the body is wrapped in `Prose`, so the shell's
 * measure and paragraph rhythm apply unchanged. A post keeps its own language:
 * `lang` marks the title and the body, and the shell carries the locale.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import Container from "../Container.astro";
import Prose from "../Prose.astro";
import ProseH1 from "../prose/ProseH1.astro";
import ProseH2 from "../prose/ProseH2.astro";
import ProseH3 from "../prose/ProseH3.astro";
import ProseH4 from "../prose/ProseH4.astro";
import ProseLink from "../prose/ProseLink.astro";
import ProseOl from "../prose/ProseOl.astro";
import TagLinks from "./TagLinks.astro";
import ui from "../../content/ui";
import { dateTime, formatLongDate } from "../../lib/dates";
import site from "../../data/site";
import { htmlLang } from "../../lib/i18n";
import { postPath, writingPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entry: WritingEntry;
}

/**
 * Markdown output carries no classes, so the elements that need a type role or
 * the link convention render through components (DESIGN.md §4, §7.8).
 */
const proseComponents = {
  h1: ProseH1,
  h2: ProseH2,
  h3: ProseH3,
  h4: ProseH4,
  a: ProseLink,
  ol: ProseOl,
};

const { entry } = Astro.props;
const { title, date, tags, summary, cover, locale } = entry.data;
const lang = htmlLang(locale);
const canonical = new URL(postPath(entry), site.url).href;
const shareHref = `https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(canonical)}`;
const copied = ui.writing.copied[locale];
const { Content } = await render(entry);
---

<article class="post">
  <Container>
    <header class="post__head measure">
      <div class="post__meta type-caption">
        <time class="tabular" datetime={dateTime(date)}>
          {formatLongDate(date, locale)}
        </time>
        {tags.length > 0 && <TagLinks tags={tags} locale={locale} />}
      </div>
      <h1 class="type-display" lang={lang}>{title}</h1>
      <p class="post__summary type-lede" lang={lang}>{summary}</p>

      <div class="post__share">
        <a
          class="post__share-button"
          href={shareHref}
          target="_blank"
          rel="noreferrer"
          aria-label={ui.writing.shareX[locale]}
        >
          <svg
            class="post__share-icon"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M21.742 21.75L14.179 10.571L21.235 2.25H18.779L13.088 8.964L8.548 2.25H2.359L9.649 13.026L2.25 21.75H4.706L10.741 14.632L15.559 21.75H21.75H21.742ZM7.739 3.818L18.81 20.182H16.363L5.29 3.818H7.737H7.739Z"
              fill="currentColor"
            />
          </svg>
        </a>
        <button
          class="post__share-button"
          type="button"
          data-copy-link
          aria-label={ui.writing.copyLink[locale]}
          data-copied-label={copied}
        >
          <svg
            class="post__share-icon post__share-icon--link"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M9 15l6 -6" />
            <path d="M11 6l.463 -.536a5 5 0 0 1 7.071 7.072l-.534 .464" />
            <path
              d="M13 18l-.397 .534a5.068 5.068 0 0 1 -7.127 0a4.972 4.972 0 0 1 0 -7.071l.524 -.463"
            />
          </svg>
          <svg
            class="post__share-icon post__share-icon--check"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 12l5 5l10 -10" />
          </svg>
        </button>
      </div>
    </header>

    {
      cover && (
        <figure class="post__cover">
          <Image
            src={cover.src}
            alt={cover.alt}
            width={1920}
            height={1080}
            widths={[720, 1440, 1920]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <Prose class="post__body" lang={lang} type="body-lg">
      <Content components={proseComponents} />
    </Prose>

    <nav class="post__foot" aria-label={ui.writing.postNav[locale]}>
      <a class="link type-label" href={writingPath(locale)}>
        {ui.writing.all[locale]}
      </a>
    </nav>
  </Container>

  <script is:inline>
    /* post-share: copies the post's own URL. */
    (() => {
      const button = document.querySelector("[data-copy-link]");
      if (!button) return;
      const name = button.getAttribute("aria-label");
      const copied = button.dataset.copiedLabel;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          button.setAttribute("data-copied", "");
          button.setAttribute("aria-label", copied);
          setTimeout(() => {
            button.removeAttribute("data-copied");
            button.setAttribute("aria-label", name);
          }, 2000);
        } catch {
          button.removeAttribute("data-copied");
        }
      });
    })();
  </script>
</article>

<style>
  /* A page-owned article rather than `Section`: the rhythm is still the band's
     64px, but the column is centred and a class handed to a component carries
     that component's scope. The measure sits in the middle of the shell; the
     text inside it stays start-aligned. */
  .post {
    /* One gap above the meta, one below the marks, one before the cover; the
       footer keeps the band's 64 below. The top pays 4.5px for the date's own
       leading, which is what the pixels measure to 48. */
    padding-block-start: calc(var(--dab-space-12) - 4.5px);
    padding-block-end: var(--dab-space-16);
  }

  .post__head {
    margin-inline: auto;
    margin-block-end: var(--dab-space-12);
  }

  /* The cover runs the container, not the measure: it belongs to the column
     the headline sits in, not to the prose. */
  .post__cover {
    margin: 0 0 var(--dab-space-12);
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface-secondary);
  }

  .post__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* `Prose` is a child component: its root carries its own scope, so the
     centring reaches it through `:global`, the documented way. */
  .post :global(.post__body) {
    margin-inline: auto;
  }

  /* The record's summary as a deck: the same sentence the shelf teases with,
     set under the headline at reading weight. */
  .post__summary {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* Date and tags open the article, above the headline. */
  /* Two quiet actions under the deck: the marks alone, no chrome of their own. */
  .post__share {
    display: flex;
    align-items: center;
    gap: var(--dab-space-3);
    /* Three pixels under the step: the summary's descender eats that much of
       the gap, so 45 reads as the 48 above and below it. */
    margin-block-start: calc(var(--dab-space-12) - 3px);
  }

  /* The button box is the 24px mark, so the gaps around the row are the gaps
     you see. The 44px target rides on a pseudo-element, which takes pointer
     events without taking space. */
  .post__share-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 24px;
    block-size: 24px;
    padding: 0;
    border: 0;
    background: none;
    /* The header's nav colour: quiet at rest, ink on hover. */
    color: var(--dab-color-text-secondary);
    cursor: pointer;
    transition: color var(--dab-duration-fast) var(--dab-easing-linear);
  }

  .post__share-button::after {
    content: "";
    position: absolute;
    inset: calc((24px - var(--dab-target-min)) / 2);
  }

  .post__share-button:hover {
    color: var(--dab-color-text-primary);
  }

  .post__share-icon {
    display: block;
    inline-size: 24px;
    block-size: 24px;
  }

  /* The copy button answers by turning into a check for two seconds. */
  .post__share-icon--check {
    display: none;
  }

  .post__share-button[data-copied] .post__share-icon--link {
    display: none;
  }

  .post__share-button[data-copied] .post__share-icon--check {
    display: block;
  }

  .post__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* The date and the tags are two lines of one block: the gap between them
       is the leading a 12px line carries, not a spacing step. */
    gap: var(--dab-space-1);
    color: var(--dab-color-text-tertiary);
  }

  /* The headline picks up the space the meta used to hold. */
  .post__head h1 {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-primary);
  }

  .post__foot {
    margin-block-start: var(--dab-space-12);
  }
</style>
