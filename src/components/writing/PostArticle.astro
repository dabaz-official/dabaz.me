---
/**
 * One post body, shared by both locale routes.
 *
 * The page owns the only `h1`; the body is wrapped in `Prose`, so the shell's
 * measure and paragraph rhythm apply unchanged. A post keeps its own language:
 * `lang` marks the title and the body, and the shell carries the locale. Below
 * the share block, a hairline opens the same-locale shelf of newer posts, set
 * as one row per article inside the prose measure.
 */
import { Image } from "astro:assets";
import { render } from "astro:content";
import Container from "../Container.astro";
import Prose from "../Prose.astro";
import ProseH1 from "../prose/ProseH1.astro";
import ProseH2 from "../prose/ProseH2.astro";
import ProseH3 from "../prose/ProseH3.astro";
import ProseH4 from "../prose/ProseH4.astro";
import ProseLink from "../prose/ProseLink.astro";
import ProseOl from "../prose/ProseOl.astro";
import PostRows from "./PostRows.astro";
import ReadMoreLink from "./ReadMoreLink.astro";
import ShareActions from "../ShareActions.astro";
import ShareScript from "../ShareScript.astro";
import TagLinks from "./TagLinks.astro";
import ui from "../../content/ui";
import site from "../../data/site";
import { dateTime, formatLongDate } from "../../lib/dates";
import { htmlLang } from "../../lib/i18n";
import { postPath, writingPath, type WritingEntry } from "../../lib/writing";

interface Props {
  entry: WritingEntry;
  /** The newest posts in this locale, the one on screen removed. */
  related: WritingEntry[];
}

/**
 * Markdown output carries no classes, so the elements that need a type role or
 * the link convention render through components (DESIGN.md §4, §7.8).
 */
const proseComponents = {
  h1: ProseH1,
  h2: ProseH2,
  h3: ProseH3,
  h4: ProseH4,
  a: ProseLink,
  ol: ProseOl,
};

const { entry, related } = Astro.props;
const { title, date, tags, summary, cover, locale } = entry.data;
const lang = htmlLang(locale);
const { Content } = await render(entry);
---

<article class="post">
  <Container>
    <header class="post__head measure">
      <div class="post__meta type-caption">
        <time class="tabular" datetime={dateTime(date)}>
          {formatLongDate(date, locale)}
        </time>
        {tags.length > 0 && <TagLinks tags={tags} locale={locale} />}
      </div>
      <h1 class="type-display" lang={lang}>{title}</h1>
      <p class="post__summary type-lede" lang={lang}>{summary}</p>

      <div class="post__share">
        <ShareActions title={title} locale={locale} path={postPath(entry)} />
      </div>
    </header>

    {
      cover && (
        <figure class="post__cover">
          <Image
            src={cover.src}
            alt={cover.alt}
            width={1920}
            height={1080}
            widths={[720, 1440, 1920]}
            sizes="(min-width: 1024px) 960px, 100vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )
    }

    <Prose class="post__body" lang={lang} type="body-lg">
      <Content components={proseComponents} />
    </Prose>

    <section class="post__share-end measure type-body-lg" aria-labelledby="post-share">
      <h2 class="type-h4" id="post-share">
        {ui.writing.shareArticle[locale]}
      </h2>
      <div class="post__share post__share--end">
        <ShareActions title={title} locale={locale} path={postPath(entry)} />
      </div>
    </section>

    {
      related.length > 0 && (
        <>
          <hr class="post__divider measure type-body-lg" />
          <section
            class="post__more measure type-body-lg"
            aria-labelledby="post-more"
          >
            <h2 class="post__more-title type-h2" id="post-more">
              {ui.writing.moreFrom[locale](site.name)}
            </h2>
            <PostRows entries={related} locale={locale} headingLevel="h3" />
          </section>
        </>
      )
    }

    <nav
      class="post__foot measure type-body-lg"
      aria-label={ui.writing.postNav[locale]}
    >
      <ReadMoreLink href={writingPath(locale)} locale={locale} />
    </nav>
  </Container>

  <ShareScript />
</article>

<style>
  /* A page-owned article rather than `Section`: the rhythm is still the band's
     64px, but the column is centred and a class handed to a component carries
     that component's scope. The measure sits in the middle of the shell; the
     text inside it stays start-aligned. */
  .post {
    /* One gap above the meta, one below the marks, one before the cover; the
       footer keeps the band's 64 below. The top pays 4.5px for the date's own
       leading, which is what the pixels measure to 48. */
    padding-block-start: calc(var(--dab-space-12) - 4.5px);
    padding-block-end: var(--dab-space-16);
  }

  .post__head {
    margin-inline: auto;
    margin-block-end: var(--dab-space-12);
  }

  /* The cover runs the container, not the measure: it belongs to the column
     the headline sits in, not to the prose. */
  .post__cover {
    margin: 0 0 var(--dab-space-12);
    overflow: clip;
    border-radius: var(--dab-radius-lg);
    background-color: var(--dab-color-surface-secondary);
  }

  .post__cover :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* `Prose` is a child component: its root carries its own scope, so the
     centring reaches it through `:global`, the documented way. */
  .post :global(.post__body) {
    margin-inline: auto;
  }

  /* The record's summary as a deck: the same sentence the shelf teases with,
     set under the headline at reading weight. */
  .post__summary {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-secondary);
    text-wrap: pretty;
  }

  /* Date and tags open the article, above the headline. */
  /* The two share rows — under the deck and at the end of the body — are the
     same element: the marks alone, 12px apart, no chrome of their own. The
     buttons' own box and states live in `ShareActions`. */
  .post__share {
    display: flex;
    align-items: center;
    gap: var(--dab-space-3);
    /* Three pixels under the step: the summary's descender eats that much of
       the gap, so 45 reads as the 48 above and below it. */
    margin-block-start: calc(var(--dab-space-12) - 3px);
  }

  /* The end-of-article block: the heading at the body's size, set bold, with
     the same marks and the same gap the article opens with. It borrows the
     reading role's font size so `measure` resolves to the prose width — 36em
     of 18px, the column the body actually occupies — rather than to the
     narrower headline measure above it. */
  .post__share-end {
    margin-inline: auto;
    margin-block-start: var(--dab-space-16);
  }

  .post__share-end h2 {
    margin: 0;
    color: var(--dab-color-text-primary);
  }

  /* The row itself is `.post__share`; only the gap above it differs. */
  .post__share--end {
    margin-block-start: var(--dab-space-4);
  }

  .post__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* The date and the tags are two lines of one block: the gap between them
       is the leading a 12px line carries, not a spacing step. */
    gap: var(--dab-space-1);
    color: var(--dab-color-text-tertiary);
  }

  /* The headline picks up the space the meta used to hold. */
  .post__head h1 {
    margin: var(--dab-space-4) 0 0;
    color: var(--dab-color-text-primary);
  }

  /* The shelf's single action: the shared `Read more` pill, centred in the
     measure. Its radius, ink and lift live in `ReadMoreLink`. */
  .post__foot {
    display: flex;
    justify-content: center;
    margin-inline: auto;
    margin-block-start: var(--dab-space-12);
  }

  /* The shelf that closes the page: a hairline at the prose measure, then the
     newest posts in this locale as one row per article. */
  .post__divider {
    margin: var(--dab-space-16) auto var(--dab-space-12);
    border: 0;
    border-block-start: var(--dab-border-width) solid var(--dab-color-border);
  }

  .post__more {
    /* The shelf stays inside the article's own column, not the page shell. */
    margin-inline: auto;
  }

  .post__more-title {
    margin: 0 0 var(--dab-space-2);
    color: var(--dab-color-text-primary);
  }
</style>
