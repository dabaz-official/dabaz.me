---
/**
 * The site footer: copyright on the left, the site's links on the right.
 *
 * A single hairline closes the page; type is caption-weight tertiary, and each
 * link darkens on hover rather than gaining an underline.
 */
import Container from "./Container.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <p class="type-caption">© {year} DabAZ</p>
    <div class="site-footer__links type-caption">
      <a href="/writing">Writing</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    border-block-start: var(--dab-border-width) solid var(--dab-color-border);
  }

  /* `Container` renders this element; see the note in SiteHeader. */
  :global(.site-footer__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--dab-space-4);
    padding-block: var(--dab-space-8);
  }

  .site-footer p {
    margin: 0;
    color: var(--dab-color-text-tertiary);
  }

  .site-footer__links {
    display: flex;
    gap: var(--dab-space-4);
  }

  .site-footer__links a {
    color: var(--dab-color-text-tertiary);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--dab-color-text-primary);
  }
</style>
