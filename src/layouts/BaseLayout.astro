---
/**
 * The document shell.
 *
 * Owns: charset/viewport, title/description/canonical from `resolveMeta`, the
 * font preload, the theme attribute, the skip link, and the header/footer
 * slots. Pages pass content and, when they need more head tags, a `head` slot.
 *
 * Theme contract: `data-theme="light" | "dark"` on `<html>`. The site ships
 * pinned to `light` while the toggle is out, so there is no theme script and
 * no client JavaScript at all; the dark token block is untouched and ready for
 * the toggle's return. Documented in `src/CONVENTIONS.md`.
 */
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { resolveMeta, type PageMeta } from "../lib/metadata";
import "../styles/global.css";

interface Props extends PageMeta {
  /** BCP 47 language tag for the document. Thread 4 owns per-locale values. */
  lang?: string;
}

const { lang = "en" } = Astro.props;
const meta = resolveMeta(Astro.props);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/DabSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body class="type-body">
    <a class="skip-link type-label" href="#main">Skip to content</a>
    <slot name="header"><SiteHeader /></slot>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer"><SiteFooter /></slot>
  </body>
</html>
