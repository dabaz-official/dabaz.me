---
/**
 * The document shell.
 *
 * Owns: charset/viewport, title/description/canonical from `resolveMeta`, the
 * font preload, the theme script (the only client JavaScript in v1), the skip
 * link, and the header/footer slots. Pages pass content and, when they need
 * more head tags, a `head` slot.
 *
 * Theme contract: `data-theme="light" | "dark"` on `<html>`; the choice is
 * stored under `theme`; no attribute means light; the script runs inline in
 * the head so a reload never flashes the wrong theme. Documented in
 * `src/CONVENTIONS.md`.
 */
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { resolveMeta, type PageMeta } from "../lib/metadata";
import "../styles/global.css";

interface Props extends PageMeta {
  /** BCP 47 language tag for the document. Thread 4 owns per-locale values. */
  lang?: string;
}

const { lang = "en" } = Astro.props;
const meta = resolveMeta(Astro.props);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/DabSans-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const k = "theme", r = document.documentElement;
        const q = matchMedia("(prefers-color-scheme: dark)");
        const get = () => { try { return localStorage.getItem(k); } catch { return null; } };
        const set = (t) => { r.dataset.theme = t; r.style.colorScheme = t; };
        const init = () => {
          const s = get();
          set(s === "light" || s === "dark" ? s : q.matches ? "dark" : "light");
        };
        init();
        q.addEventListener("change", () => { if (!get()) init(); });
        document.addEventListener("click", (e) => {
          if (!e.target.closest("[data-theme-toggle]")) return;
          const t = r.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem(k, t); } catch {}
          set(t);
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="type-body">
    <a class="skip-link type-label" href="#main">Skip to content</a>
    <slot name="header"><SiteHeader /></slot>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer"><SiteFooter /></slot>
  </body>
</html>
